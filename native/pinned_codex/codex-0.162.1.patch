+async fn run_strict_provider_turn(
+    sess: Arc<Session>,
+    turn_context: Arc<TurnContext>,
+    input: Vec<TurnInput>,
+    cancellation_token: CancellationToken,
+) -> CodexResult<Option<String>> {
+    use codex_protocol::models::FunctionCallOutputPayload;
+    use codex_protocol::protocol::ItemCompletedEvent;
+    use codex_tools::{JsonSchema, ResponsesApiTool, ToolSpec};
+
+    let context = crate::symphony_boundary::context()
+        .ok_or_else(|| CodexErr::InvalidRequest("SYMPHONY_CONTEXT_UNAVAILABLE".into()))?;
+    let user = turn_user_input(&input);
+    let [UserInput::Text { text, .. }] = user.as_slice() else {
+        return Err(crate::symphony_boundary::provider_boundary_unavailable());
+    };
+    if text != &context.prompt_text
+        || context.deadline <= std::time::Instant::now()
+        || cancellation_token.is_cancelled()
+    {
+        return Err(CodexErr::TurnAborted);
+    }
+    let thread_id = sess.thread_id();
+    crate::symphony_boundary::transport::set_rpc_ids(&thread_id.to_string(), &turn_context.sub_id)
+        .map_err(|_| crate::symphony_boundary::provider_boundary_unavailable())?;
+    let model_client = crate::client::ModelClient::new_symphony_synthetic(
+        thread_id,
+        turn_context.provider.info().clone(),
+        turn_context.session_source.clone(),
+    )?;
+    let mut model_session = model_client.new_session();
+    let model_info = Arc::clone(turn_context.model_info());
+    let properties = std::collections::BTreeMap::from([
+        (
+            "cmd".into(),
+            JsonSchema::string_enum(
+                vec![serde_json::json!(crate::symphony_boundary::BROKER_COMMAND)],
+                None,
+            ),
+        ),
+        (
+            "workdir".into(),
+            JsonSchema::string_enum(
+                vec![serde_json::json!(context.workspace.to_string_lossy())],
+                None,
+            ),
+        ),
+        ("login".into(), JsonSchema::boolean(None)),
+        ("tty".into(), JsonSchema::boolean(None)),
+    ]);
+    let required = properties.keys().cloned().collect();
+    let tool = ToolSpec::Function(ResponsesApiTool {
+        name: "exec_command".into(),
+        description: "Read the one approved Planner input.".into(),
+        strict: true,
+        defer_loading: None,
+        parameters: JsonSchema::object(properties, Some(required), Some(false.into())),
+        output_schema: None,
+    });
+    let user_item = ResponseItem::Message {
+        id: None,
+        role: "user".into(),
+        content: vec![ContentItem::InputText { text: text.clone() }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let mut prompt = Prompt {
+        input: vec![user_item.clone()],
+        tools: Arc::from(vec![tool]),
+        parallel_tool_calls: false,
+        base_instructions: BaseInstructions {
+            text: context.policy_text.clone(),
+            provenance: None,
+        },
+        output_schema: None,
+        output_schema_strict: true,
+        cyber_access_program: None,
+    };
+    let thread_text = thread_id.to_string();
+    let mut metadata = CodexResponsesMetadata::new(
+        context.host_identity.clone(),
+        thread_text.clone(),
+        thread_text,
+        context.binding_id.clone(),
+    );
+    metadata.turn_id = Some(turn_context.sub_id.clone());
+    let trace = codex_rollout_trace::InferenceTraceContext::disabled();
+    let mut response_items = Vec::new();
+    let mut first_completed = None;
+    let mut diagnostic = StrictR1Diagnostic::default();
+    diagnostic.stage("R1_STREAM_ENTERED");
+    let opened = model_session
+        .stream(
+            &prompt,
+            &model_info,
+            &turn_context.session_telemetry,
+            turn_context.effective_reasoning_effort(),
+            turn_context.reasoning_summary(),
+            None,
+            &metadata,
+            &trace,
+        )
+        .await;
+    let mut stream = diagnostic.checked("stream_open_error", opened)?;
+    diagnostic.stage("R1_STREAM_OPENED");
+    let mut preamble = StrictResponsePreamble::default();
+    while let Some(event) = futures::StreamExt::next(&mut stream).await {
+        let event = diagnostic.checked("stream_event_error", event)?;
+        if preamble.consume(&event) {
+            continue;
+        }
+        if diagnostic.event_counts.iter().all(|&count| count == 0) {
+            diagnostic.stage("R1_STREAM_EVENT_OBSERVED");
+        }
+        let index = match &event {
+            ResponseEvent::Created { .. } => 0,
+            ResponseEvent::OutputItemAdded(_) => 1,
+            ResponseEvent::OutputItemDone(item) => {
+                diagnostic.output_item_count += 1;
+                diagnostic.function_call_present |=
+                    matches!(item, ResponseItem::FunctionCall { .. });
+                2
+            }
+            ResponseEvent::Completed { end_turn, .. } => {
+                diagnostic.end_turn = Some(*end_turn);
+                3
+            }
+            ResponseEvent::OutputTextDelta(_) => 4,
+            ResponseEvent::ToolCallInputDelta { .. } => 5,
+            _ => 6,
+        };
+        diagnostic.event_counts[index] = diagnostic.event_counts[index].saturating_add(1);
+        match event {
+            ResponseEvent::OutputItemDone(item) => response_items.push(item),
+            ResponseEvent::Completed { end_turn, .. } => first_completed = Some(end_turn),
+            ResponseEvent::Created { .. }
+            | ResponseEvent::OutputItemAdded(_)
+            | ResponseEvent::OutputTextDelta(_)
+            | ResponseEvent::ToolCallInputDelta { .. } => {}
+            _ => {
+                return diagnostic.checked(
+                    "unexpected_stream_event",
+                    Err(crate::symphony_boundary::provider_boundary_unavailable()),
+                );
+            }
+        }
+    }
+    diagnostic.stage("R1_STREAM_COMPLETED");
+    if first_completed != Some(Some(false)) || response_items.len() != 1 {
+        return diagnostic.checked(
+            "completion_or_item_count",
+            Err(crate::symphony_boundary::provider_boundary_unavailable()),
+        );
+    }
+    diagnostic.stage("R1_STREAM_VALIDATION_PASSED");
+    diagnostic.stage("R1_TOOL_CONSTRUCTION_ENTERED");
+    let function_call = diagnostic.checked(
+        "output_item_missing",
+        response_items
+            .pop()
+            .ok_or_else(crate::symphony_boundary::provider_boundary_unavailable),
+    )?;
+    let constructed = diagnostic.checked(
+        "tool_construction_error",
+        ToolRouter::build_tool_call(function_call.clone())
+            .map_err(|_| crate::symphony_boundary::provider_boundary_unavailable()),
+    )?;
+    let tool_call = diagnostic.checked(
+        "tool_call_missing",
+        constructed.ok_or_else(crate::symphony_boundary::provider_boundary_unavailable),
+    )?;
+    diagnostic.stage("R1_TOOL_CONSTRUCTION_PASSED");
+    diagnostic.stage("R1_TOOL_DISPATCH_ENTERED");
+    let dispatched = ToolRouter::start_protected_tool(&tool_call)
+        .await
+        .map_err(|_| crate::symphony_boundary::provider_boundary_unavailable());
+    diagnostic.stage("R1_TOOL_DISPATCH_RETURNED");
+    let started = diagnostic.checked("tool_dispatch_error", dispatched)?;
+    drop(diagnostic);
+    let output =
+        crate::exec::collect_protected_output(started, Some(cancellation_token.clone())).await?;
+    if cancellation_token.is_cancelled()
+        || output.exit_code != 0
+        || output.timed_out
+        || !output.stderr.text.is_empty()
+    {
+        return Err(CodexErr::TurnAborted);
+    }
+    let tool_output_text = output.stdout.text;
+    let function_call_output = ResponseItem::FunctionCallOutput {
+        id: None,
+        call_id: Some(tool_call.call_id.clone()),
+        name: Some("exec_command".into()),
+        namespace: None,
+        output: FunctionCallOutputPayload::from_text(tool_output_text),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    prompt.input.push(function_call);
+    prompt.input.push(function_call_output);
+    let mut final_items = Vec::new();
+    let mut second_completed = None;
+    let mut stream = model_session
+        .stream(
+            &prompt,
+            &model_info,
+            &turn_context.session_telemetry,
+            turn_context.effective_reasoning_effort(),
+            turn_context.reasoning_summary(),
+            None,
+            &metadata,
+            &trace,
+        )
+        .await?;
+    let mut preamble = StrictResponsePreamble::default();
+    while let Some(event) = futures::StreamExt::next(&mut stream).await {
+        let event = event?;
+        if preamble.consume(&event) {
+            continue;
+        }
+        match event {
+            ResponseEvent::OutputItemDone(item) => final_items.push(item),
+            ResponseEvent::Completed { end_turn, .. } => second_completed = Some(end_turn),
+            ResponseEvent::Created { .. }
+            | ResponseEvent::OutputItemAdded(_)
+            | ResponseEvent::OutputTextDelta(_)
+            | ResponseEvent::ToolCallInputDelta { .. } => {}
+            _ => return Err(crate::symphony_boundary::provider_boundary_unavailable()),
+        }
+    }
+    if second_completed != Some(Some(true)) || final_items.len() != 1 {
+        return Err(crate::symphony_boundary::provider_boundary_unavailable());
+    }
+    let final_item = final_items
+        .pop()
+        .ok_or_else(|| crate::symphony_boundary::provider_boundary_unavailable())?;
+    if !matches!(
+        &final_item,
+        ResponseItem::Message {
+            role,
+            phase: Some(MessagePhase::FinalAnswer),
+            ..
+        } if role == "assistant"
+    ) {
+        return Err(crate::symphony_boundary::provider_boundary_unavailable());
+    }
+    let finalized =
+        handle_non_tool_response_item(&sess, TurnItemContributorPolicy::Skip, &final_item, false)
+            .await
+            .ok_or_else(|| crate::symphony_boundary::provider_boundary_unavailable())?;
+    let last_answer = last_assistant_message_from_item(&final_item, false)
+        .ok_or_else(|| crate::symphony_boundary::provider_boundary_unavailable())?;
+    sess.send_event(
+        &turn_context,
+        EventMsg::ItemCompleted(ItemCompletedEvent {
+            thread_id,
+            turn_id: turn_context.sub_id.clone(),
+            item: finalized,
+            started_at_ms: None,
+            completed_at_ms: std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map_err(|_| crate::symphony_boundary::provider_boundary_unavailable())?
+                .as_millis() as i64,
+        }),
+    )
+    .await;
+    Ok(Some(last_answer))
+}
