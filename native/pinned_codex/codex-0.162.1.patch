+        }
+        if count != 1 {
+            return Err(REFUSED);
+        }
+        *total += 1;
+        if *total > 262144 || bytes.len() >= 65536 {
+            return Err(REFUSED);
+        }
+        if b == b'\n' {
+            return serde_json::from_slice(&bytes)
+                .map(Some)
+                .map_err(|_| REFUSED);
+        }
+        bytes.push(b);
+    }
+}
+
+fn wire_thread(
+    configured: &codex_protocol::protocol::SessionConfiguredEvent,
+) -> Result<codex_app_server_protocol::Thread> {
+    let observed = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(|_| REFUSED)?
+        .as_secs() as i64;
+    Ok(codex_app_server_protocol::Thread {
+        id: configured.thread_id.to_string(),
+        environments: Some(Vec::new()),
+        extra: None,
+        session_id: configured.session_id.to_string(),
+        forked_from_id: None,
+        parent_thread_id: None,
+        preview: String::new(),
+        ephemeral: true,
+        section: None,
+        section_entered_at: None,
+        project_id: None,
+        history_mode: codex_protocol::protocol::ThreadHistoryMode::default().into(),
+        model_provider: configured.model_provider_id.clone(),
+        model: Some(configured.model.clone()),
+        reasoning_effort: configured.reasoning_effort.clone(),
+        created_at: observed,
+        updated_at: observed,
+        recency_at: None,
+        status: codex_app_server_protocol::ThreadStatus::Idle,
+        path: None,
+        cwd: configured.cwd.clone(),
+        cli_version: env!("CARGO_PKG_VERSION").into(),
+        originator: Some("symphony-protected-synthetic".into()),
+        source: codex_protocol::protocol::SessionSource::Exec.into(),
+        can_accept_direct_input: Some(true),
+        thread_source: None,
+        agent_nickname: None,
+        agent_role: None,
+        git_info: None,
+        name: None,
+        daybreak_enabled: None,
+        turns: Vec::new(),
+    })
+}
+fn wire_turn(
+    id: String,
+    root: Option<String>,
+    status: codex_app_server_protocol::TurnStatus,
+    error: Option<codex_protocol::protocol::ErrorEvent>,
+    started_at: Option<i64>,
+    completed_at: Option<i64>,
+    duration_ms: Option<i64>,
+) -> codex_app_server_protocol::Turn {
+    codex_app_server_protocol::Turn {
+        id,
+        root_turn_id: root,
+        items: Vec::new(),
+        items_view: codex_app_server_protocol::TurnItemsView::NotLoaded,
+        status,
+        error: error.map(|error| codex_app_server_protocol::TurnError {
+            message: error.message,
+            codex_error_info: error.codex_error_info.map(Into::into),
+            additional_details: None,
+            misalignment: None,
+        }),
+        started_at,
+        completed_at,
+        duration_ms,
+    }
+}
+
+pub fn run(value: Value, deadline: u64) -> Result<()> {
+    let ctx = context(value, deadline)?;
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(1)
+        // Match the pinned arg0 runtime stack budget without its helper dispatch.
+        // Core turn futures require this budget even when external services are absent.
+        .thread_stack_size(16 * 1024 * 1024)
+        .enable_time()
+        .build()
+        .map_err(|_| "SYMPHONY_THREAD_REFUSED")?;
+    let result = runtime.block_on(async {
+        if tokio::spawn(async { 1621_u32 })
+            .await
+            .map_err(|_| "SYMPHONY_THREAD_REFUSED")?
+            != 1621
+        {
+            return Err("SYMPHONY_THREAD_REFUSED");
+        }
+        session(ctx, deadline).await
+    });
+    let counts = codex_core::symphony_boundary::effect_counts();
+    // Synthetic-only audit metadata, separate from real core protocol events.
+    // Zero counts do not prove coverage of a client entry that was never reached.
+    eprintln!(
+        "{}",
+        json!({"symphonySyntheticCounts": {
+            "providerRefusals":counts.provider_refusals, "auth":counts.auth,
+            "http":counts.http, "websocket":counts.websocket, "responses":counts.responses,
+            "retry":counts.retry, "fallback":counts.fallback,
+            "discovery":counts.discovery, "process":counts.process
+        }})
+    );
+    result
+}
+
+async fn session(ctx: Arc<SymphonyContext>, deadline: u64) -> Result<()> {
+    let config = Config::from_symphony_context(&ctx)
+        .await
+        .map_err(|_| "SYMPHONY_CONFIG_REFUSED")?;
+    let manager = ThreadManager::new_strict(Arc::clone(&ctx), config)
+        .map_err(|_| "SYMPHONY_STRICT_SERVICES_UNAVAILABLE")?;
+    emit(
+        json!({"ready":true,"binding":ctx.binding_id,"qualified_host":false,
+        "version":env!("CARGO_PKG_VERSION"),"controls":{
+            "protected_codex_entry":true,"tokio_thread":true,"fork_denied":true,
+            "exec_denied":true,"ptrace_denied":true,"inet_socket_denied":true,
+            "process_clone_denied":true,"credential_fds_absent":true,"fresh_home":true}}),
+        deadline,
+    )?;
+    let mut total = 0;
+    let mut initialized = false;
+    let mut acknowledged = false;
+    let mut thread = None;
+    let mut admitted = false;
+    let mut request_ids = std::collections::HashSet::new();
+    let outcome = async {
+        while let Some(message) = read(deadline, &mut total)? {
+            keys(&message, &["id", "method", "params"])?;
+            let method = text(&message, "method")?;
+            let params = message.get("params").cloned().unwrap_or_else(|| json!({}));
+            if method == "initialized" && initialized && !acknowledged && message.get("id").is_none() {
+                keys(&params, &[])?;
+                acknowledged = true;
+                continue;
+            }
+            let id = message.get("id").filter(|id| id.is_i64() || id.as_str().is_some_and(|s| s.len() <= 64))
+                .cloned().ok_or(REFUSED)?;
+            if !request_ids.insert(id.to_string()) { return Err(REFUSED); }
+            match method.as_str() {
+                "initialize" if !initialized => {
+                    keys(&params, &["clientInfo"])?;
+                    keys(params.get("clientInfo").ok_or(REFUSED)?, &["name", "version", "title"])?;
+                    let _: codex_app_server_protocol::InitializeParams = serde_json::from_value(params).map_err(|_| REFUSED)?;
+                    emit(json!({"id":id,"result":{"userAgent":"codex-app-server protected synthetic",
+                        "codexHome":ctx.codex_home,"platformFamily":"unix","platformOs":"linux"}}), deadline)?;
+                    initialized = true;
+                }
+                "thread/start" if acknowledged && thread.is_none() => {
+                    keys(&params, &[])?;
+                    let created = tokio::time::timeout(remaining(deadline)?, manager.start_strict_thread())
+                        .await.map_err(|_| "SYMPHONY_DEADLINE")?.map_err(|_| "SYMPHONY_THREAD_REFUSED")?;
+                    let thread_id = created.thread_id.to_string();
+                    let wire = wire_thread(&created.session_configured)?;
+                    let configured = &created.session_configured;
+                    let response = codex_app_server_protocol::ThreadStartResponse {
+                        thread: wire.clone(), model: configured.model.clone(),
+                        model_provider: configured.model_provider_id.clone(), service_tier: None,
+                        disabled_plugin_ids: Vec::new(), cwd: configured.cwd.clone(),
+                        runtime_workspace_roots: vec![configured.cwd.clone()], instruction_sources: Vec::new(),
+                        approval_policy: configured.approval_policy.clone().into(),
+                        approvals_reviewer: configured.approvals_reviewer.into(),
+                        sandbox: configured.permission_profile.to_legacy_sandbox_policy(&ctx.workspace)
+                            .map_err(|_| REFUSED)?.into(),
+                        active_permission_profile: configured.active_permission_profile.clone().map(Into::into),
+                        reasoning_effort: configured.reasoning_effort.clone(),
+                        multi_agent_mode: codex_protocol::config_types::MultiAgentMode::ExplicitRequestOnly,
+                    };
+                    emit(json!({"id":id,"result":response}), deadline)?;
+                    emit(json!({"method":"thread/started","params":{"thread":wire}}), deadline)?;
+                    thread = Some((thread_id, created.thread));
+                }
+                "turn/start" if !admitted => {
+                    keys(&params, &["threadId", "input"])?;
+                    let (thread_id, core) = thread.as_ref().ok_or(REFUSED)?;
+                    if text(&params, "threadId")? != *thread_id { return Err(REFUSED); }
+                    let input = params.get("input").and_then(Value::as_array).ok_or(REFUSED)?;
+                    if input.len() != 1 { return Err(REFUSED); }
+                    keys(&input[0], &["type", "text"])?;
+                    if text(&input[0], "type")? != "text" || text(&input[0], "text")? != ctx.prompt_text {
+                        return Err(REFUSED);
+                    }
+                    admitted = true;
+                    let request = TurnInputRequest::new(TurnInput::UserInput {
+                        content: vec![UserInput::Text { text:ctx.prompt_text.clone(), text_elements:Vec::new() }], client_id:None,
+                    });
+                    let (reply, response) = tokio::sync::oneshot::channel();
+                    core.submit(Op::TurnInput { request:Box::new(request), mode:TurnInputMode::StartIfIdle, reply })
+                        .await.map_err(|_| REFUSED)?;
+                    let actual = tokio::time::timeout(remaining(deadline)?, response).await
+                        .map_err(|_| "SYMPHONY_DEADLINE")?.map_err(|_| REFUSED)?.map_err(|_| REFUSED)?;
+                    let TurnInputSubmission::Started { turn_id, root_turn_id } = actual else { return Err(REFUSED); };
+                    emit(json!({"id":id,"result":codex_app_server_protocol::TurnStartResponse {
+                        turn:wire_turn(turn_id.clone(), Some(root_turn_id),
+                            codex_app_server_protocol::TurnStatus::InProgress, None, None, None, None)
+                    }}), deadline)?;
+                    let mut started = false;
+                    let mut error_seen = false;
+                    loop {
+                        // Poll only the already-open control pipe. No I/O reactor or
+                        // background reader is created in the protected holder.
+                        let mut input = libc::pollfd { fd: 0, events: libc::POLLIN, revents: 0 };
+                        let observed = unsafe { libc::poll(&mut input, 1, 0) };
+                        if observed < 0 { return Err(REFUSED); }
+                        if input.revents & libc::POLLIN != 0 {
+                            let interrupt = read(deadline, &mut total)?.ok_or(REFUSED)?;
+                            keys(&interrupt, &["id", "method", "params"])?;
+                            if text(&interrupt, "method")? != "turn/interrupt" { return Err(REFUSED); }
+                            let interrupt_id = interrupt.get("id")
+                                .filter(|id| id.is_i64() || id.as_str().is_some_and(|s| s.len() <= 64))
+                                .cloned().ok_or(REFUSED)?;
+                            if !request_ids.insert(interrupt_id.to_string()) { return Err(REFUSED); }
+                            let params = interrupt.get("params").ok_or(REFUSED)?;
+                            keys(params, &["threadId", "turnId"])?;
+                            if text(params, "threadId")? != *thread_id || text(params, "turnId")? != turn_id {
+                                return Err(REFUSED);
+                            }
+                            core.submit(Op::Interrupt).await.map_err(|_| REFUSED)?;
+                            emit(json!({"id":interrupt_id,"result":
+                                codex_app_server_protocol::TurnInterruptResponse {}}), deadline)?;
+                        }
+                        let event = match tokio::time::timeout(
+                            remaining(deadline)?.min(Duration::from_millis(5)), core.next_event()).await {
+                            Ok(event) => event.map_err(|_| REFUSED)?,
+                            Err(_) => { remaining(deadline)?; continue; }
+                        };
+                        if event.id != turn_id { return Err("SYMPHONY_CORE_EVIDENCE_REFUSED"); }
+                        match event.msg {
+                            EventMsg::TurnStarted(actual) if !started && actual.turn_id == turn_id => {
+                                started = true;
+                                emit(json!({"method":"turn/started","params":{"threadId":thread_id,
+                                    "turn":wire_turn(actual.turn_id, actual.root_turn_id,
+                                        codex_app_server_protocol::TurnStatus::InProgress, None,
+                                        actual.started_at, None, None)}}), deadline)?;
+                            }
+                            EventMsg::Error(error) if started && !error_seen && error.message == PROVIDER => {
+                                error_seen = true;
+                                emit(json!({"method":"error","params":codex_app_server_protocol::ErrorNotification {
+                                    thread_id:thread_id.clone(), turn_id:turn_id.clone(), will_retry:false,
+                                    error:codex_app_server_protocol::TurnError {
+                                        message:error.message,
+                                        codex_error_info:error.codex_error_info.map(Into::into),
+                                        additional_details:None, misalignment:None,
+                                    }
+                                }}), deadline)?;
+                            }
+                            EventMsg::TurnComplete(actual) if started && error_seen && actual.turn_id == turn_id
+                                && actual.last_agent_message.is_none()
+                                && actual.error.as_ref().is_some_and(|error| error.message == PROVIDER) => {
+                                emit(json!({"method":"turn/completed","params":{"threadId":thread_id,
+                                    "turn":wire_turn(actual.turn_id, actual.root_turn_id,
+                                        codex_app_server_protocol::TurnStatus::Failed, actual.error,
+                                        actual.started_at, actual.completed_at, actual.duration_ms)}}), deadline)?;
+                                break;
+                            }
+                            EventMsg::TurnAborted(actual) if started && !error_seen && actual.error.is_none()
+                                && actual.turn_id.as_deref() == Some(&turn_id) => {
+                                emit(json!({"method":"turn/completed","params":{"threadId":thread_id,
+                                    "turn":wire_turn(turn_id.clone(), actual.root_turn_id,
+                                        codex_app_server_protocol::TurnStatus::Interrupted, actual.error,
+                                        actual.started_at, actual.completed_at, actual.duration_ms)}}), deadline)?;
+                                break;
+                            }
+                            _ => return Err("SYMPHONY_CORE_EVIDENCE_REFUSED"),
+                        }
+                    }
+                }
+                _ => return Err(REFUSED),
+            }
+        }
+        Ok(())
+    }.await;
+    // No normal-success return is stop proof. The caller still requires the
+    // native namespace/PID/port observations owned by C03.
+    let stopped = tokio::time::timeout(
+        remaining(deadline)?,
+        manager.shutdown_all_threads_bounded(remaining(deadline)?),
+    )
+    .await
+    .map_err(|_| "SYMPHONY_DISPOSAL_UNCONFIRMED")?;
+    if codex_core::symphony_boundary::stop_unconfirmed()
+        || !stopped.submit_failed.is_empty()
+        || !stopped.timed_out.is_empty()
+        || thread.as_ref().is_some_and(|(id, _)| {
+            !stopped
+                .completed
+                .iter()
+                .any(|actual| actual.to_string() == *id)
+        })
+    {
+        return Err("SYMPHONY_DISPOSAL_UNCONFIRMED");
+    }
+    outcome
+}
