diff --git a/codex-rs/app-server/src/symphony_gate2.rs b/codex-rs/app-server/src/symphony_gate2.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5b95fc15a62e4644bde704239dc4a5649f692dc7
--- /dev/null
+++ b/codex-rs/app-server/src/symphony_gate2.rs
@@ -0,0 +1,477 @@
+//! Early, synthetic-only H-100 holder entry. Never invokes generic startup.
+//!
+//! This is a partial J3/J4 implementation in the actual standalone app-server.
+//! Host custody, broker and provider qualification are absent: thread/turn use
+//! always refuses. Neither initialization nor native readiness proves inference.
+
+pub(crate) fn try_run() -> Option<i32> {
+    let args: Vec<_> = std::env::args_os().skip(1).collect();
+    let selected = args
+        .iter()
+        .any(|arg| arg.to_string_lossy().starts_with("--symphony-"));
+    if !selected {
+        return None;
+    }
+    #[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+    let result = linux::run(&args);
+    #[cfg(not(all(target_os = "linux", target_arch = "x86_64")))]
+    let result: Result<(), &'static str> = Err("SYMPHONY_PLATFORM_REFUSED");
+    Some(match result {
+        Ok(()) => 0,
+        Err(code) => {
+            // Never print arguments, material, requests or provider metadata.
+            eprintln!("{code}");
+            78
+        }
+    })
+}
+
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+mod linux {
+    use codex_app_server_protocol::InitializeParams;
+    use codex_app_server_protocol::InitializeResponse;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+    use serde::Deserialize;
+    use serde_json::json;
+    use sha2::Digest;
+    use std::fs::File;
+    use std::io::Read;
+    use std::io::Write;
+    use std::os::fd::FromRawFd;
+    use std::os::unix::fs::MetadataExt;
+
+    type Result<T> = std::result::Result<T, &'static str>;
+    const REFUSED: &str = "SYMPHONY_HOST_UNQUALIFIED";
+    const THREAD_FLAGS: u32 = (libc::CLONE_VM
+        | libc::CLONE_FS
+        | libc::CLONE_FILES
+        | libc::CLONE_SIGHAND
+        | libc::CLONE_THREAD
+        | libc::CLONE_SYSVSEM
+        | libc::CLONE_SETTLS
+        | libc::CLONE_PARENT_SETTID
+        | libc::CLONE_CHILD_CLEARTID) as u32;
+
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Manifest {
+        schema: u32,
+        profile: String,
+        binding: String,
+        attempt: String,
+        holder_sha256: String,
+        deadline_ms: u64,
+        fault: String,
+    }
+
+    fn now() -> Result<u64> {
+        let mut ts = libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 0,
+        };
+        if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) } != 0 {
+            return Err("SYMPHONY_CLOCK_REFUSED");
+        }
+        Ok(ts.tv_sec as u64 * 1000 + ts.tv_nsec as u64 / 1_000_000)
+    }
+
+    fn instruction(code: u16, jt: u8, jf: u8, k: u32) -> libc::sock_filter {
+        libc::sock_filter { code, jt, jf, k }
+    }
+
+    fn protect() -> Result<()> {
+        // Install before manifest, material, configuration or runtime access.
+        let zero = libc::rlimit {
+            rlim_cur: 0,
+            rlim_max: 0,
+        };
+        if unsafe { libc::setrlimit(libc::RLIMIT_CORE, &zero) } != 0
+            || unsafe { libc::prctl(libc::PR_SET_DUMPABLE, 0) } != 0
+            || unsafe { libc::prctl(libc::PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) } != 0
+        {
+            return Err("SYMPHONY_HARDENING_REFUSED");
+        }
+        // seccomp_data: nr=0, arch=4, args[0]=16, args[1]=24,
+        // args[2]=32. Gate both the native architecture and x32 syscall bit.
+        let mut code = vec![
+            instruction(0x20, 0, 0, 4),
+            instruction(0x15, 1, 0, 0xc000003e),
+            instruction(0x06, 0, 0, 0x80000000),
+            instruction(0x20, 0, 0, 0),
+            instruction(0x35, 0, 1, 0x40000000),
+            instruction(0x06, 0, 0, 0x80000000),
+            // Only the exact qualified pthread flags may create a thread.
+            instruction(0x15, 0, 6, libc::SYS_clone as u32),
+            instruction(0x20, 0, 0, 16),
+            instruction(0x15, 0, 3, THREAD_FLAGS),
+            instruction(0x20, 0, 0, 20), // high word of args[0], not child_stack
+            instruction(0x15, 0, 1, 0),
+            instruction(0x06, 0, 0, 0x7fff0000),
+            instruction(0x06, 0, 0, 0x00050000 | libc::EPERM as u32),
+            instruction(0x20, 0, 0, 0),
+            // glibc falls back from ENOSYS clone3 to the guarded clone path.
+            instruction(0x15, 0, 1, libc::SYS_clone3 as u32),
+            instruction(0x06, 0, 0, 0x00050000 | libc::ENOSYS as u32),
+            // Core limits cannot be raised after installation. Read-only
+            // prlimit queries remain available to the thread/runtime library.
+            instruction(0x15, 0, 6, libc::SYS_prlimit64 as u32),
+            instruction(0x20, 0, 0, 32),
+            instruction(0x15, 0, 3, 0),
+            instruction(0x20, 0, 0, 36),
+            instruction(0x15, 0, 1, 0),
+            instruction(0x06, 0, 0, 0x7fff0000),
+            instruction(0x06, 0, 0, 0x00050000 | libc::EPERM as u32),
+            instruction(0x20, 0, 0, 0),
+            instruction(0x15, 0, 4, libc::SYS_prctl as u32),
+            instruction(0x20, 0, 0, 16),
+            instruction(0x15, 0, 1, libc::PR_SET_DUMPABLE as u32),
+            instruction(0x06, 0, 0, 0x00050000 | libc::EPERM as u32),
+            instruction(0x06, 0, 0, 0x7fff0000),
+            instruction(0x20, 0, 0, 0),
+        ];
+        for syscall in [
+            libc::SYS_fork,
+            libc::SYS_vfork,
+            libc::SYS_execve,
+            libc::SYS_execveat,
+            libc::SYS_ptrace,
+            libc::SYS_process_vm_readv,
+            libc::SYS_process_vm_writev,
+            libc::SYS_pidfd_getfd,
+            libc::SYS_kcmp,
+            libc::SYS_bpf,
+            libc::SYS_perf_event_open,
+            libc::SYS_unshare,
+            libc::SYS_setns,
+            libc::SYS_mount,
+            libc::SYS_umount2,
+            libc::SYS_setuid,
+            libc::SYS_setgid,
+            libc::SYS_setresuid,
+            libc::SYS_setresgid,
+            libc::SYS_setreuid,
+            libc::SYS_setregid,
+            libc::SYS_setgroups,
+            libc::SYS_capset,
+            libc::SYS_setfsuid,
+            libc::SYS_setfsgid,
+            libc::SYS_chroot,
+            libc::SYS_pivot_root,
+            libc::SYS_personality,
+            libc::SYS_open_tree,
+            libc::SYS_move_mount,
+            libc::SYS_fsopen,
+            libc::SYS_fsmount,
+            libc::SYS_mount_setattr,
+            libc::SYS_setrlimit,
+            libc::SYS_socket,
+            libc::SYS_socketpair,
+        ] {
+            code.push(instruction(0x15, 0, 1, syscall as u32));
+            code.push(instruction(0x06, 0, 0, 0x00050000 | libc::EPERM as u32));
+        }
+        code.push(instruction(0x06, 0, 0, 0x7fff0000));
+        let program = libc::sock_fprog {
+            len: code.len() as u16,
+            filter: code.as_mut_ptr(),
+        };
+        if unsafe { libc::prctl(libc::PR_SET_SECCOMP, libc::SECCOMP_MODE_FILTER, &program) } != 0 {
+            return Err("SYMPHONY_SECCOMP_REFUSED");
+        }
+        Ok(())
+    }
+
+    fn hexadecimal(text: &str) -> bool {
+        text.len() == 64
+            && text
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    }
+
+    fn manifest(binding: &str, attempt: &str) -> Result<Manifest> {
+        // FD4 is the sole approved non-stdio descriptor. It contains no access.
+        let seals = unsafe { libc::fcntl(4, libc::F_GET_SEALS) };
+        let required =
+            libc::F_SEAL_WRITE | libc::F_SEAL_GROW | libc::F_SEAL_SHRINK | libc::F_SEAL_SEAL;
+        if seals < 0 || seals & required != required {
+            return Err("SYMPHONY_MANIFEST_UNSEALED");
+        }
+        let mut file = unsafe { File::from_raw_fd(4) };
+        let size = file
+            .metadata()
+            .map_err(|_| "SYMPHONY_MANIFEST_REFUSED")?
+            .len();
+        if size == 0 || size > 2048 {
+            return Err("SYMPHONY_MANIFEST_REFUSED");
+        }
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes)
+            .map_err(|_| "SYMPHONY_MANIFEST_REFUSED")?;
+        drop(file); // Close before any runtime thread or protocol processing.
+        for fd in 0..3 {
+            let mut status: libc::stat = unsafe { std::mem::zeroed() };
+            if unsafe { libc::fstat(fd, &mut status) } != 0
+                || status.st_mode & libc::S_IFMT != libc::S_IFIFO
+            {
+                return Err("SYMPHONY_CONTROL_PIPE_REFUSED");
+            }
+        }
+        for fd in 3..1024 {
+            if unsafe { libc::fcntl(fd, libc::F_GETFD) } >= 0 {
+                return Err("SYMPHONY_DESCRIPTOR_REFUSED");
+            }
+        }
+        // The bootstrap is responsible for its exact FD allowlist. A /proc/self
+        // census below covers the whole actual descriptor set without repairing it.
+        let count = std::fs::read_dir("/proc/self/fd")
+            .map_err(|_| "SYMPHONY_DESCRIPTOR_REFUSED")?
+            .count();
+        if count != 4 {
+            // stdio plus read_dir's own descriptor.
+            return Err("SYMPHONY_DESCRIPTOR_REFUSED");
+        }
+        let manifest: Manifest =
+            serde_json::from_slice(&bytes).map_err(|_| "SYMPHONY_MANIFEST_REFUSED")?;
+        if manifest.binding != binding
+            || manifest.attempt != attempt
+            || manifest.schema != 1
+            || manifest.profile != "C02_PINNED_CODEX_SYNTHETIC_V1"
+            || !hexadecimal(&manifest.binding)
+            || !hexadecimal(&manifest.holder_sha256)
+            || manifest.attempt.is_empty()
+            || manifest.attempt.len() > 128
+            || !manifest
+                .attempt
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+            || !matches!(
+                manifest.fault.as_str(),
+                "none" | "continuous" | "ambiguous_provider" | "controls_unavailable"
+            )
+            || manifest.deadline_ms <= now()?
+            || manifest.deadline_ms > now()? + 5000
+        {
+            return Err("SYMPHONY_MANIFEST_REFUSED");
+        }
+        let mut executable =
+            File::open("/proc/self/exe").map_err(|_| "SYMPHONY_IDENTITY_REFUSED")?;
+        let mut hash = sha2::Sha256::new();
+        let mut buf = [0_u8; 8192];
+        loop {
+            if manifest.deadline_ms <= now()? {
+                return Err("SYMPHONY_DEADLINE");
+            }
+            let n = executable
+                .read(&mut buf)
+                .map_err(|_| "SYMPHONY_IDENTITY_REFUSED")?;
+            if n == 0 {
+                break;
+            }
+            hash.update(&buf[..n]);
+        }
+        if format!("{:x}", hash.finalize()) != manifest.holder_sha256 {
+            return Err("SYMPHONY_IDENTITY_REFUSED");
+        }
+        Ok(manifest)
+    }
+
+    fn fresh_home(name: &str) -> Result<String> {
+        let path = std::env::var(name).map_err(|_| "SYMPHONY_HOME_REFUSED")?;
+        let meta = std::fs::symlink_metadata(&path).map_err(|_| "SYMPHONY_HOME_REFUSED")?;
+        if !std::path::Path::new(&path).is_absolute()
+            || !meta.is_dir()
+            || meta.mode() & 0o7777 != 0o700
+            || meta.uid() != unsafe { libc::geteuid() }
+            || std::fs::read_dir(&path)
+                .map_err(|_| "SYMPHONY_HOME_REFUSED")?
+                .next()
+                .is_some()
+        {
+            return Err("SYMPHONY_HOME_REFUSED");
+        }
+        Ok(path)
+    }
+
+    fn line(deadline: u64) -> Result<Option<Vec<u8>>> {
+        let mut bytes = Vec::new();
+        loop {
+            let remaining = deadline.saturating_sub(now()?);
+            if remaining == 0 {
+                return Err("SYMPHONY_DEADLINE");
+            }
+            let mut fd = libc::pollfd {
+                fd: 0,
+                events: libc::POLLIN,
+                revents: 0,
+            };
+            if unsafe { libc::poll(&mut fd, 1, remaining.min(i32::MAX as u64) as i32) } <= 0 {
+                return Err("SYMPHONY_DEADLINE");
+            }
+            let mut byte = [0_u8; 1];
+            let n = unsafe { libc::read(0, byte.as_mut_ptr().cast(), 1) };
+            if n < 0 {
+                return Err("SYMPHONY_PROTOCOL_REFUSED");
+            }
+            if n == 0 {
+                return Ok(None);
+            }
+            if byte[0] == b'\n' {
+                return Ok(Some(bytes));
+            }
+            if bytes.len() >= 8192 {
+                return Err("SYMPHONY_PROTOCOL_REFUSED");
+            }
+            bytes.push(byte[0]);
+        }
+    }
+
+    fn emit(value: &serde_json::Value) -> Result<()> {
+        let mut stdout = std::io::stdout().lock();
+        serde_json::to_writer(&mut stdout, value).map_err(|_| "SYMPHONY_OUTPUT_REFUSED")?;
+        writeln!(stdout).map_err(|_| "SYMPHONY_OUTPUT_REFUSED")?;
+        stdout.flush().map_err(|_| "SYMPHONY_OUTPUT_REFUSED")
+    }
+
+    pub(super) fn run(args: &[std::ffi::OsString]) -> Result<()> {
+        protect()?;
+        if args.len() != 3 || args[0] != "--symphony-pilot-holder" {
+            return Err("SYMPHONY_LAUNCH_FORM_REFUSED");
+        }
+        let binding = args[1].to_str().ok_or("SYMPHONY_LAUNCH_FORM_REFUSED")?;
+        let attempt = args[2].to_str().ok_or("SYMPHONY_LAUNCH_FORM_REFUSED")?;
+        let manifest = manifest(binding, attempt)?;
+        if manifest.fault == "controls_unavailable" {
+            return Err("SYMPHONY_HARDENING_REFUSED");
+        }
+        if manifest.deadline_ms <= now()? {
+            return Err("SYMPHONY_DEADLINE");
+        }
+        let _home = fresh_home("HOME")?;
+        let codex_home = fresh_home("CODEX_HOME")?;
+        let mut synthetic = std::env::var("ACCESS_TOKEN")
+            .map_err(|_| "SYMPHONY_SYNTHETIC_MATERIAL_REFUSED")?
+            .into_bytes();
+        let material_ok = synthetic.len() == 50
+            && synthetic.starts_with(b"SYNTHETIC-NONLIVE-")
+            && synthetic[18..].iter().all(u8::is_ascii_hexdigit);
+        synthetic.fill(0);
+        if !material_ok {
+            return Err("SYMPHONY_SYNTHETIC_MATERIAL_REFUSED");
+        }
+        let errno = || std::io::Error::last_os_error().raw_os_error();
+        let fork_result = unsafe { libc::syscall(libc::SYS_fork) };
+        if fork_result == 0 {
+            unsafe { libc::_exit(79) };
+        }
+        let fork_denied = fork_result == -1 && errno() == Some(libc::EPERM);
+        if fork_result > 0 {
+            unsafe { libc::waitpid(fork_result as i32, std::ptr::null_mut(), 0) };
+        }
+        let exec_denied =
+            unsafe { libc::syscall(libc::SYS_execve, c"/nonexistent".as_ptr(), 0_usize, 0_usize) }
+                == -1
+                && errno() == Some(libc::EPERM);
+        let ptrace_denied = unsafe {
+            libc::syscall(
+                libc::SYS_ptrace,
+                libc::PTRACE_PEEKDATA,
+                0_usize,
+                0_usize,
+                0_usize,
+            )
+        } == -1
+            && errno() == Some(libc::EPERM);
+        let socket_result = unsafe { libc::socket(libc::AF_INET, libc::SOCK_STREAM, 0) };
+        let socket_denied = socket_result == -1 && errno() == Some(libc::EPERM);
+        if socket_result >= 0 {
+            unsafe { libc::close(socket_result) };
+        }
+        let clone_result = unsafe {
+            libc::syscall(
+                libc::SYS_clone,
+                libc::SIGCHLD,
+                0_usize,
+                0_usize,
+                0_usize,
+                0_usize,
+            )
+        };
+        if clone_result == 0 {
+            unsafe { libc::_exit(79) };
+        }
+        let clone_denied = clone_result == -1 && errno() == Some(libc::EPERM);
+        if clone_result > 0 {
+            unsafe { libc::waitpid(clone_result as i32, std::ptr::null_mut(), 0) };
+        }
+        if !(fork_denied && exec_denied && ptrace_denied && socket_denied && clone_denied) {
+            return Err("SYMPHONY_KERNEL_PROOF_REFUSED");
+        }
+        // A real Tokio worker must start using only qualified pthread clone flags.
+        let runtime = tokio::runtime::Builder::new_multi_thread()
+            .worker_threads(1)
+            .enable_time()
+            .build()
+            .map_err(|_| "SYMPHONY_THREAD_REFUSED")?;
+        let thread_ok = runtime
+            .block_on(async { tokio::spawn(async { 1621_u32 }).await })
+            .map_err(|_| "SYMPHONY_THREAD_REFUSED")?
+            == 1621;
+        if !thread_ok {
+            return Err("SYMPHONY_THREAD_REFUSED");
+        }
+        if manifest.deadline_ms <= now()? {
+            return Err("SYMPHONY_DEADLINE");
+        }
+        // Native readiness is process-restriction proof only, never host or auth readiness.
+        let mut out = std::io::stdout().lock();
+        writeln!(out, "{{\"ready\":true,\"binding\":\"{}\",\"controls\":{{\"protected_codex_entry\":true,\"tokio_thread\":true,\"fork_denied\":true,\"exec_denied\":true,\"ptrace_denied\":true,\"inet_socket_denied\":true,\"process_clone_denied\":true,\"credential_fds_absent\":true,\"fresh_home\":true}},\"qualified_host\":false,\"version\":\"{}\"}}", manifest.binding, env!("CARGO_PKG_VERSION")).map_err(|_| "SYMPHONY_OUTPUT_REFUSED")?;
+        out.flush().map_err(|_| "SYMPHONY_OUTPUT_REFUSED")?;
+        drop(out);
+        let mut initialized = false;
+        while let Some(bytes) = line(manifest.deadline_ms)? {
+            let request: serde_json::Value =
+                serde_json::from_slice(&bytes).map_err(|_| "SYMPHONY_PROTOCOL_REFUSED")?;
+            let id = request
+                .get("id")
+                .and_then(serde_json::Value::as_i64)
+                .ok_or("SYMPHONY_PROTOCOL_REFUSED")?;
+            if request.get("method").and_then(serde_json::Value::as_str) == Some("initialize")
+                && !initialized
+            {
+                let _: InitializeParams = serde_json::from_value(
+                    request
+                        .get("params")
+                        .cloned()
+                        .ok_or("SYMPHONY_PROTOCOL_REFUSED")?,
+                )
+                .map_err(|_| "SYMPHONY_PROTOCOL_REFUSED")?;
+                let response = InitializeResponse {
+                    user_agent: format!(
+                        "codex-app-server/{} symphony-protected-synthetic",
+                        env!("CARGO_PKG_VERSION")
+                    ),
+                    codex_home: AbsolutePathBuf::try_from(codex_home.clone())
+                        .map_err(|_| "SYMPHONY_HOME_REFUSED")?,
+                    platform_family: "unix".into(),
+                    platform_os: "linux".into(),
+                };
+                emit(&json!({"id":id,"result":response}))?;
+                initialized = true;
+            } else {
+                if manifest.fault == "ambiguous_provider" {
+                    return Err("SYMPHONY_SYNTHETIC_EFFECT_AMBIGUOUS");
+                }
+                if manifest.fault == "continuous" {
+                    while now()? < manifest.deadline_ms {
+                        emit(&json!({"method":"symphony/progress"}))?;
+                        std::thread::sleep(std::time::Duration::from_millis(1));
+                    }
+                    return Err("SYMPHONY_DEADLINE");
+                }
+                emit(&json!({"id":id,"error":{"code":-32091,"message":REFUSED}}))?;
+                return Ok(());
+            }
+        }
+        Ok(())
+    }
+}
