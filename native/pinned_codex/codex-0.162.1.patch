+            "policy_text",
+            "holder_sha256",
+            "holder_profile",
+            "holder_profile_digest",
+            "permission_reference",
+            "host_identity",
+            "boot_identity",
+            "credential_generation",
+            "model_slug",
+            "model_catalog_digest",
+            "model_catalog",
+            "text_digest",
+            "prompt_text",
+            "context_digest",
+            "workspace",
+            "home",
+            "codex_home",
+            "wait_for_interrupt",
+            "broker_selftest",
+        ],
+    )?;
+    let digest = text(&value, "context_digest")?;
+    value
+        .as_object_mut()
+        .ok_or(REFUSED)?
+        .remove("context_digest");
+    if hash(&serde_json::to_vec(&value).map_err(|_| REFUSED)?) != digest
+        || hash(text(&value, "policy_text")?.as_bytes()) != text(&value, "policy_digest")?
+        || hash(text(&value, "prompt_text")?.as_bytes()) != text(&value, "text_digest")?
+        || hash(
+            &serde_json::to_vec(value.get("model_catalog").ok_or(REFUSED)?).map_err(|_| REFUSED)?,
+        ) != text(&value, "model_catalog_digest")?
+        || text(&value, "home")? != std::env::var("HOME").map_err(|_| REFUSED)?
+        || text(&value, "codex_home")? != std::env::var("CODEX_HOME").map_err(|_| REFUSED)?
+    {
+        return Err("SYMPHONY_CONTEXT_INVALID");
+    }
+    let context = SymphonyContext {
+        project_id: text(&value, "project_id")?,
+        work_item_id: text(&value, "work_item_id")?,
+        role: text(&value, "role")?,
+        binding_id: text(&value, "binding_id")?,
+        attempt_id: text(&value, "attempt_id")?,
+        grant_id: text(&value, "grant_id")?,
+        configuration_digest: text(&value, "configuration_digest")?,
+        source_commit: text(&value, "source_commit")?,
+        source_tree: text(&value, "source_tree")?,
+        policy_digest: text(&value, "policy_digest")?,
+        policy_text: text(&value, "policy_text")?,
+        holder_sha256: text(&value, "holder_sha256")?,
+        holder_profile: text(&value, "holder_profile")?,
+        holder_profile_digest: text(&value, "holder_profile_digest")?,
+        permission_reference: text(&value, "permission_reference")?,
+        host_identity: text(&value, "host_identity")?,
+        boot_identity: text(&value, "boot_identity")?,
+        credential_generation: text(&value, "credential_generation")?,
+        model_slug: text(&value, "model_slug")?,
+        model_catalog_digest: text(&value, "model_catalog_digest")?,
+        text_digest: text(&value, "text_digest")?,
+        prompt_text: text(&value, "prompt_text")?,
+        workspace: path(&value, "workspace")?,
+        home: path(&value, "home")?,
+        codex_home: path(&value, "codex_home")?,
+        policy_root: path(&value, "policy_root")?,
+        context_digest: digest,
+        model_catalog: value.get("model_catalog").cloned().ok_or(REFUSED)?,
+        deadline: Instant::now() + remaining(deadline)?,
+        provider_nonce: provider.as_ref().map(|values| values.0.clone()),
+        fixture_sha256: provider.as_ref().map(|values| values.1.clone()),
+        wait_for_interrupt: match value.get("wait_for_interrupt") {
+            None => false,
+            Some(Value::Bool(value)) => *value,
+            Some(_) => return Err("SYMPHONY_CONTEXT_INVALID"),
+        },
+    };
+    install_context(context).map_err(|_| "SYMPHONY_CONTEXT_INVALID")
+}
+
+fn poll(fd: i32, events: i16, deadline: u64) -> Result<()> {
+    let mut descriptor = libc::pollfd {
+        fd,
+        events,
+        revents: 0,
+    };
+    let wait = remaining(deadline)?.as_millis().min(i32::MAX as u128) as i32;
+    if unsafe { libc::poll(&mut descriptor, 1, wait) } <= 0 {
+        return Err("SYMPHONY_DEADLINE");
+    }
+    if descriptor.revents & (events | libc::POLLHUP) == 0 {
+        return Err(REFUSED);
+    }
+    Ok(())
+}
+fn emit(value: Value, deadline: u64) -> Result<()> {
+    let mut bytes = serde_json::to_vec(&value).map_err(|_| REFUSED)?;
+    bytes.push(b'\n');
+    // One bounded atomic pipe write after POLLOUT, never an unbounded flush.
+    if bytes.len() > 4096 {
+        return Err("SYMPHONY_OUTPUT_REFUSED");
+    }
+    poll(1, libc::POLLOUT, deadline)?;
+    if unsafe { libc::write(1, bytes.as_ptr().cast(), bytes.len()) } != bytes.len() as isize {
+        return Err("SYMPHONY_OUTPUT_REFUSED");
+    }
+    Ok(())
+}
+fn read(deadline: u64, total: &mut usize) -> Result<Option<Value>> {
+    let mut bytes = Vec::new();
+    loop {
+        poll(0, libc::POLLIN, deadline)?;
+        let mut b = 0_u8;
+        let count = unsafe { libc::read(0, (&mut b as *mut u8).cast(), 1) };
+        if count == 0 {
+            return if bytes.is_empty() {
+                Ok(None)
+            } else {
+                Err(REFUSED)
+            };
+        }
+        if count != 1 {
+            return Err(REFUSED);
+        }
+        *total += 1;
+        if *total > 262144 || bytes.len() >= 65536 {
+            return Err(REFUSED);
+        }
+        if b == b'\n' {
+            return serde_json::from_slice(&bytes)
+                .map(Some)
+                .map_err(|_| REFUSED);
+        }
+        bytes.push(b);
+    }
+}
