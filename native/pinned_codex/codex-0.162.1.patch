+pub(crate) async fn start_protected_request(
+    request: &ExecRequest,
+    call_id: Option<&str>,
+) -> Result<codex_exec_server::StartedExecProcess> {
+    let refused = || CodexErr::InvalidRequest("SYMPHONY_BROKER_REFUSED".into());
+    if !request.env.is_empty()
+        || request.exec_server_env_config.is_some()
+        || request.exec_server_shell_snapshot.is_some()
+        || request.network.is_some()
+        || request.network_environment_id.is_some()
+        || request.arg0.is_some()
+        || request.exec_server_enforce_managed_network
+        || request.exec_server_managed_network.is_some()
+        || request.exec_server_network_proxy.is_some()
+        || request.exec_server_sandbox.is_some()
+        || request
+            .expiration
+            .cancellation_token()
+            .is_some_and(|token| token.is_cancelled())
+    {
+        return Err(refused());
+    }
+    crate::symphony_boundary::start_broker(&request.command, &request.cwd, call_id)
+        .await
+        .map_err(|_| refused())
+}
+
+pub(crate) async fn collect_protected_output(
+    started: codex_exec_server::StartedExecProcess,
+    cancellation: Option<CancellationToken>,
+) -> Result<ExecToolCallOutput> {
+    use codex_exec_server::{ExecOutputStream, ExecProcessEvent};
+    let refused = || CodexErr::InvalidRequest("SYMPHONY_BROKER_REFUSED".into());
+    let start = Instant::now();
+    let mut events = started.process.subscribe_events();
+    let mut stdout = Vec::new();
+    let mut stderr = Vec::new();
+    let mut exit = None;
+    loop {
+        let event = tokio::select! {
+            event = events.recv() => event.map_err(|_| refused())?,
+            () = async {
+                if let Some(cancellation) = &cancellation {
+                    cancellation.cancelled().await;
+                } else {
+                    std::future::pending::<()>().await;
+                }
+            } => {
+                started.process.terminate().await.map_err(|_| refused())?;
+                return Err(refused());
+            }
+        };
+        match event {
+            ExecProcessEvent::Output(chunk) => match chunk.stream {
+                ExecOutputStream::Stdout => stdout.extend_from_slice(chunk.chunk.0.as_slice()),
+                ExecOutputStream::Stderr => stderr.extend_from_slice(chunk.chunk.0.as_slice()),
+                _ => return Err(refused()),
+            },
+            ExecProcessEvent::Exited { exit_code, .. } => exit = Some(exit_code),
+            ExecProcessEvent::Closed { .. } => break,
+            ExecProcessEvent::Failed(_) => return Err(refused()),
+        }
+    }
+    let stdout = StreamOutput {
+        text: stdout,
+        truncated_after_lines: None,
+    };
+    let stderr = StreamOutput {
+        text: stderr,
+        truncated_after_lines: None,
+    };
+    Ok(ExecToolCallOutput {
+        exit_code: exit.ok_or_else(refused)?,
+        aggregated_output: aggregate_output(&stdout, &stderr, None).from_utf8_lossy(),
+        stdout: stdout.from_utf8_lossy(),
+        stderr: stderr.from_utf8_lossy(),
+        duration: start.elapsed(),
+        timed_out: false,
+    })
+}
