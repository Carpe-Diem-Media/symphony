@@ -0,0 +1,1081 @@
+//! One-use backend for the protected Symphony tool broker.
+//!
+//! The inherited pipes identify the broker. JSON identity fields bind each
+//! frame to the permit, holder, attempt and operation that the host selected.
+
+use std::collections::VecDeque;
+use std::io::{Read, Write};
+use std::os::fd::{AsRawFd, OwnedFd};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use codex_network_proxy::NetworkPolicyDecider;
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value};
+use tokio::sync::{Mutex, Notify, watch};
+use tokio::time::{Instant, timeout_at};
+
+use crate::ExecBackend;
+use crate::ExecBackendFuture;
+use crate::ExecProcess;
+use crate::ExecProcessEvent;
+use crate::ExecProcessEventReceiver;
+use crate::ExecProcessFuture;
+use crate::StartedExecProcess;
+use crate::client::ExecServerError;
+use crate::process::ExecProcessEventLog;
+use crate::protocol::{
+    ExecOutputStream, ExecParams, ProcessId, ProcessOutputChunk, ProcessSignal, ReadResponse,
+    WriteResponse,
+};
+
+const MAX_FRAME: usize = 8192;
+const MAX_OUTPUT_CHUNK: usize = 4096;
+const MAX_TOTAL_OUTPUT: usize = 16_384;
+const EVENT_CAPACITY: usize = 128;
+const MAX_OPERATION_TIME: Duration = Duration::from_secs(1);
+const STOP_RESERVE: Duration = Duration::from_millis(250);
+
+/// Host-issued identity for one operation. Values must be non-empty ASCII.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct FrameBinding {
+    pub attempt_id: String,
+    pub binding_digest: String,
+    pub channel_nonce: String,
+    pub deadline_ms: u64,
+    pub file_sha256: String,
+    pub grant_id: String,
+    pub holder_sha256: String,
+    pub holder_incarnation: String,
+    pub operation_id: String,
+    pub permit_id: String,
+    pub permit_revision: String,
+    pub source_commit: String,
+    pub source_tree: String,
+    pub tool_call_id: String,
+}
+
+/// Exact request authority supplied by the trusted protected-context owner.
+#[derive(Debug, Clone)]
+pub struct BrokerPermit {
+    pub expected_params: ExecParams,
+    pub binding: FrameBinding,
+    pub selector: String,
+    pub argv_sha256: String,
+    pub cwd_sha256: String,
+}
+
+/// One-use adapter over the FD5 request and FD6 reply channels.
+pub struct SymphonyExecBackend {
+    permit: Mutex<Option<BrokerPermit>>,
+    request: Mutex<Option<Arc<std::fs::File>>>,
+    reply: Mutex<Option<Arc<std::fs::File>>>,
+    consumed: AtomicBool,
+    started_identity: Mutex<Option<BrokerProcessIdentity>>,
+}
+
+/// Child identity correlated by the inherited broker reply pipe.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct BrokerProcessIdentity {
+    pub pid: u32,
+    pub start_ticks: u64,
+}
+
+impl SymphonyExecBackend {
+    pub fn new(
+        permit: BrokerPermit,
+        request: OwnedFd,
+        reply: OwnedFd,
+    ) -> Result<Self, ExecServerError> {
+        validate_binding(&permit.binding)?;
+        validate_exec_params(&permit.expected_params)?;
+        if permit.selector != "planner_input_head8"
+            || permit.binding.permit_revision != "1"
+            || !is_digest(&permit.argv_sha256)
+            || !is_digest(&permit.cwd_sha256)
+        {
+            return Err(protocol(
+                "broker permit has an invalid operation selector or digest",
+            ));
+        }
+        Ok(Self {
+            permit: Mutex::new(Some(permit)),
+            request: Mutex::new(Some(nonblocking_pipe(request)?)),
+            reply: Mutex::new(Some(nonblocking_pipe(reply)?)),
+            consumed: AtomicBool::new(false),
+            started_identity: Mutex::new(None),
+        })
+    }
+
+    /// Returns the broker-reported process identity after a successful start.
+    pub async fn started_identity(&self) -> Option<BrokerProcessIdentity> {
+        *self.started_identity.lock().await
+    }
+
+    async fn start_inner(&self, params: ExecParams) -> Result<StartedExecProcess, ExecServerError> {
+        if self.consumed.swap(true, Ordering::AcqRel) {
+            return Err(protocol("broker permit was already consumed"));
+        }
+        let permit = self
+            .permit
+            .lock()
+            .await
+            .take()
+            .ok_or_else(|| protocol("broker permit is unavailable"))?;
+        if params != permit.expected_params {
+            return Err(protocol("exec request does not match the broker permit"));
+        }
+        validate_exec_params(&params)?;
+
+        let binding = Arc::new(permit.binding);
+        let selector = permit.selector;
+        let argv_sha256 = permit.argv_sha256;
+        let cwd_sha256 = permit.cwd_sha256;
+        let (start_deadline, deadline) = deadlines(binding.deadline_ms)?;
+        let request = self
+            .request
+            .lock()
+            .await
+            .take()
+            .ok_or_else(|| protocol("request pipe is unavailable"))?;
+        let reply = self
+            .reply
+            .lock()
+            .await
+            .take()
+            .ok_or_else(|| protocol("reply pipe is unavailable"))?;
+        let (wake_tx, _wake_rx) = watch::channel(0_u64);
+        let inner = Arc::new(ProcessInner {
+            process_id: params.process_id,
+            binding,
+            selector,
+            argv_sha256,
+            cwd_sha256,
+            request: Mutex::new(Some(request)),
+            state: Mutex::new(ProcessState {
+                next_seq: 1,
+                ..ProcessState::default()
+            }),
+            changed: Notify::new(),
+            wake_tx,
+            events: ExecProcessEventLog::new(EVENT_CAPACITY, MAX_TOTAL_OUTPUT),
+            deadline,
+            start_deadline,
+        });
+
+        send_frame(&inner, "START_READ", 1, true).await?;
+        let reader_inner = Arc::clone(&inner);
+        tokio::spawn(async move { read_frames(reader_inner, reply, 1).await });
+        wait_started(&inner).await?;
+        let identity = inner
+            .state
+            .lock()
+            .await
+            .started
+            .map(|(pid, start_ticks)| BrokerProcessIdentity { pid, start_ticks });
+        *self.started_identity.lock().await = identity;
+
+        let process = Arc::new(SymphonyExecProcess { inner });
+        let monitor = Arc::clone(&process);
+        tokio::spawn(async move { monitor_operation(monitor).await });
+        Ok(StartedExecProcess {
+            process,
+            sandbox_type: None,
+        })
+    }
+}
+
+impl ExecBackend for SymphonyExecBackend {
+    fn start(&self, params: ExecParams) -> ExecBackendFuture<'_> {
+        Box::pin(self.start_inner(params))
+    }
+
+    fn prewarm_shell_snapshot(&self, _params: ExecParams) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async {
+            Err(protocol(
+                "shell snapshots are forbidden by the broker permit",
+            ))
+        })
+    }
+
+    fn start_with_network_policy_decider(
+        &self,
+        _params: ExecParams,
+        _decider: Arc<dyn NetworkPolicyDecider>,
+    ) -> ExecBackendFuture<'_> {
+        Box::pin(async {
+            Err(protocol(
+                "network policy requests are forbidden by the broker permit",
+            ))
+        })
+    }
+}
+
+struct ProcessInner {
+    process_id: ProcessId,
+    binding: Arc<FrameBinding>,
+    selector: String,
+    argv_sha256: String,
+    cwd_sha256: String,
+    request: Mutex<Option<Arc<std::fs::File>>>,
+    state: Mutex<ProcessState>,
+    changed: Notify,
+    wake_tx: watch::Sender<u64>,
+    events: ExecProcessEventLog,
+    deadline: Instant,
+    start_deadline: Instant,
+}
+
+#[derive(Default)]
+struct ProcessState {
+    output: VecDeque<ProcessOutputChunk>,
+    next_seq: u64,
+    total_bytes: usize,
+    started: Option<(u32, u64)>,
+    exit_code: Option<i32>,
+    stop_confirmed: bool,
+    closed: bool,
+    failure: Option<String>,
+    stop_sent: bool,
+    stop_sending: bool,
+}
+
+struct SymphonyExecProcess {
+    inner: Arc<ProcessInner>,
+}
+
+fn stop_confirmation_ready(state: &ProcessState, identity: (u32, u64)) -> bool {
+    state.started == Some(identity)
+        && state.exit_code.is_some()
+        && state.stop_sent
+        && !state.stop_confirmed
+        && !state.closed
+        && state.failure.is_none()
+}
+
+async fn read_frames(inner: Arc<ProcessInner>, reply: Arc<std::fs::File>, mut expected_seq: u64) {
+    loop {
+        let reader = Arc::clone(&reply);
+        let deadline = inner.deadline.into_std();
+        let frame =
+            match tokio::task::spawn_blocking(move || receive_frame(&reader, deadline)).await {
+                Ok(Ok(frame)) => frame,
+                Ok(Err(error)) => {
+                    fail(&inner, format!("broker reply failed: {error}")).await;
+                    return;
+                }
+                Err(_) => {
+                    fail(&inner, "broker deadline expired".to_string()).await;
+                    return;
+                }
+            };
+        let parsed = match parse_frame(&frame, &inner.binding, expected_seq) {
+            Ok(parsed) => parsed,
+            Err(error) => {
+                fail(&inner, error.to_string()).await;
+                return;
+            }
+        };
+        expected_seq += 1;
+        let operation = parsed
+            .get("operation")
+            .and_then(Value::as_str)
+            .unwrap_or_default();
+        match operation {
+            "STARTED" => {
+                let (Some(pid), Some(start_ticks)) =
+                    (u32_field(&parsed, "pid"), u64_field(&parsed, "start_ticks"))
+                else {
+                    fail(&inner, "invalid STARTED identity".to_string()).await;
+                    return;
+                };
+                let mut state = inner.state.lock().await;
+                if state.started.replace((pid, start_ticks)).is_some() || state.next_seq != 1 {
+                    drop(state);
+                    fail(&inner, "duplicate or late STARTED".to_string()).await;
+                    return;
+                }
+                inner.changed.notify_waiters();
+            }
+            "REFUSED" => {
+                let reason = parsed
+                    .get("reason")
+                    .and_then(Value::as_str)
+                    .unwrap_or_default();
+                if ![
+                    "PERMIT_INVALID",
+                    "SOURCE_CHANGED",
+                    "DEADLINE",
+                    "BROKER_BUSY",
+                    "SPAWN_REFUSED",
+                    "tool_uncertain",
+                ]
+                .contains(&reason)
+                {
+                    fail(&inner, "REFUSED reason is not allowlisted".to_string()).await;
+                    return;
+                }
+                fail(&inner, format!("broker refused operation: {reason}")).await;
+                return;
+            }
+            "OUTPUT" => {
+                let (Some(stream), Some(data)) = (
+                    parsed.get("stream").and_then(Value::as_str),
+                    parsed.get("data").and_then(Value::as_str),
+                ) else {
+                    fail(&inner, "invalid OUTPUT fields".to_string()).await;
+                    return;
+                };
+                let stream = match stream {
+                    "stdout" => ExecOutputStream::Stdout,
+                    "stderr" => ExecOutputStream::Stderr,
+                    _ => {
+                        fail(&inner, "invalid output stream".to_string()).await;
+                        return;
+                    }
+                };
+                let bytes = match STANDARD.decode(data) {
+                    Ok(bytes) if bytes.len() <= MAX_OUTPUT_CHUNK => bytes,
+                    _ => {
+                        fail(&inner, "invalid or oversized output data".to_string()).await;
+                        return;
+                    }
+                };
+                let mut state = inner.state.lock().await;
+                if state.started.is_none()
+                    || state.exit_code.is_some()
+                    || state.closed
+                    || state.total_bytes.saturating_add(bytes.len()) > MAX_TOTAL_OUTPUT
+                {
+                    drop(state);
+                    fail(
+                        &inner,
+                        "output violates process state or byte limit".to_string(),
+                    )
+                    .await;
+                    return;
+                }
+                let seq = state.next_seq;
+                state.next_seq += 1;
+                state.total_bytes += bytes.len();
+                let chunk = ProcessOutputChunk {
+                    seq,
+                    stream,
+                    chunk: bytes.clone().into(),
+                };
+                state.output.push_back(chunk.clone());
+                inner.events.publish(ExecProcessEvent::Output(chunk));
+                inner.wake_tx.send_replace(seq + 1);
+                inner.changed.notify_waiters();
+            }
+            "EXIT" => {
+                let (Some(pid), Some(ticks), Some(exit_code)) = (
+                    u32_field(&parsed, "pid"),
+                    u64_field(&parsed, "start_ticks"),
+                    parsed.get("exit_code").and_then(Value::as_i64),
+                ) else {
+                    fail(&inner, "invalid EXIT fields".to_string()).await;
+                    return;
+                };
+                let mut state = inner.state.lock().await;
+                if state.started != Some((pid, ticks))
+                    || state.exit_code.is_some()
+                    || !(-255..=255).contains(&exit_code)
+                {
+                    drop(state);
+                    fail(&inner, "EXIT violates process state".to_string()).await;
+                    return;
+                }
+                state.exit_code = Some(exit_code as i32);
+                let seq = state.next_seq;
+                state.next_seq += 1;
+                inner.events.publish(ExecProcessEvent::Exited {
+                    seq,
+                    exit_code: exit_code as i32,
+                    sandbox_denied: None,
+                });
+                inner.wake_tx.send_replace(seq + 1);
+                inner.changed.notify_waiters();
+            }
+            "STOP_CONFIRMED" => {
+                let (Some(pid), Some(ticks)) =
+                    (u32_field(&parsed, "pid"), u64_field(&parsed, "start_ticks"))
+                else {
+                    fail(&inner, "invalid STOP_CONFIRMED fields".to_string()).await;
+                    return;
+                };
+                let state = inner.state.lock().await;
+                if !stop_confirmation_ready(&state, (pid, ticks)) {
+                    drop(state);
+                    fail(
+                        &inner,
+                        "STOP_CONFIRMED lacks matching terminal proof".to_string(),
+                    )
+                    .await;
+                    return;
+                }
+                drop(state);
+                // STOP_CONFIRMED is provisional until the helper closes its reply
+                // channel. Any later frame, including a duplicate, invalidates it.
+                let eof_reader = Arc::clone(&reply);
+                let eof_deadline = inner.deadline.into_std();
+                match tokio::task::spawn_blocking(move || {
+                    receive_frame_or_eof(&eof_reader, eof_deadline)
+                })
+                .await
+                {
+                    Ok(Ok(boundary)) => match verify_reply_eof(boundary) {
+                        Ok(()) => {
+                            let mut state = inner.state.lock().await;
+                            if stop_confirmation_ready(&state, (pid, ticks)) {
+                                state.stop_confirmed = true;
+                                state.closed = true;
+                                let seq = state.next_seq;
+                                state.next_seq += 1;
+                                inner.events.publish(ExecProcessEvent::Closed { seq });
+                                inner.wake_tx.send_replace(seq + 1);
+                                inner.changed.notify_waiters();
+                            } else {
+                                drop(state);
+                                fail(
+                                    &inner,
+                                    "process state changed before STOP_CONFIRMED boundary"
+                                        .to_string(),
+                                )
+                                .await;
+                            }
+                        }
+                        Err(error) => fail(&inner, error.to_string()).await,
+                    },
+                    Ok(Err(error)) => {
+                        fail(&inner, format!("broker reply boundary failed: {error}")).await
+                    }
+                    Err(_) => {
+                        fail(
+                            &inner,
+                            "broker reply boundary worker unavailable".to_string(),
+                        )
+                        .await
+                    }
+                }
+                return;
+            }
+            _ => {
+                fail(&inner, "unexpected broker operation".to_string()).await;
+                return;
+            }
+        }
+    }
+}
+
+async fn wait_started(inner: &Arc<ProcessInner>) -> Result<(), ExecServerError> {
+    loop {
+        let notified = inner.changed.notified();
+        let state = inner.state.lock().await;
+        if state.started.is_some() {
+            return Ok(());
+        }
+        if let Some(error) = &state.failure {
+            return Err(protocol(error.clone()));
+        }
+        drop(state);
+        timeout_at(inner.start_deadline, notified)
+            .await
+            .map_err(|_| protocol("broker STARTED deadline expired"))?;
+    }
+}
+
+async fn fail(inner: &ProcessInner, message: String) {
+    let mut state = inner.state.lock().await;
+    if state.failure.is_none() {
+        state.failure = Some(message.clone());
+        inner.events.publish(ExecProcessEvent::Failed(message));
+        inner.changed.notify_waiters();
+        inner
+            .wake_tx
+            .send_modify(|seq| *seq = seq.saturating_add(1));
+    }
+}
+
+async fn monitor_operation(process: Arc<SymphonyExecProcess>) {
+    let monitor_deadline = (Instant::now() + MAX_OPERATION_TIME).min(process.inner.deadline);
+    loop {
+        let notified = process.inner.changed.notified();
+        let state = process.inner.state.lock().await;
+        if state.failure.is_some() || state.stop_confirmed {
+            return;
+        }
+        if state.exit_code.is_some() {
+            break;
+        }
+        drop(state);
+        if timeout_at(monitor_deadline, notified).await.is_err() {
+            break;
+        }
+    }
+    if let Err(error) = process.terminate().await {
+        fail(
+            &process.inner,
+            format!("broker stop could not be confirmed: {error}"),
+        )
+        .await;
+    }
+}
+
+async fn send_frame(
+    inner: &ProcessInner,
+    operation: &str,
+    sequence: u64,
+    is_start: bool,
+) -> Result<(), ExecServerError> {
+    let mut map = binding_map(&inner.binding);
+    map.insert("operation".into(), Value::String(operation.to_string()));
+    map.insert("sequence".into(), Value::from(sequence));
+    if is_start {
+        map.insert("selector".into(), Value::String(inner.selector.clone()));
+        map.insert(
+            "argv_sha256".into(),
+            Value::String(inner.argv_sha256.clone()),
+        );
+        map.insert("cwd_sha256".into(), Value::String(inner.cwd_sha256.clone()));
+        map.insert("stdin".into(), Value::Bool(false));
+        map.insert("tty".into(), Value::Bool(false));
+    }
+    let deadline = if is_start {
+        inner.start_deadline
+    } else {
+        inner.deadline
+    };
+    let writer = Arc::clone(
+        inner
+            .request
+            .lock()
+            .await
+            .as_ref()
+            .ok_or_else(|| protocol("broker request pipe is closed"))?,
+    );
+    tokio::task::spawn_blocking(move || {
+        write_frame(&writer, Value::Object(map), deadline.into_std())
+    })
+    .await
+    .map_err(|_| protocol("broker request write worker unavailable"))?
+}
+
+fn write_frame(
+    writer: &std::fs::File,
+    value: Value,
+    deadline: std::time::Instant,
+) -> Result<(), ExecServerError> {
+    let bytes = serde_json::to_vec(&canonicalize(value))?;
+    if bytes.is_empty() || bytes.len() > MAX_FRAME {
+        return Err(protocol("broker frame exceeds 8192 bytes"));
+    }
+    let len = u32::try_from(bytes.len()).map_err(|_| protocol("broker frame length overflow"))?;
+    let mut framed = len.to_be_bytes().to_vec();
+    framed.extend(bytes);
+    let mut offset = 0;
+    while offset < framed.len() {
+        ready(writer, libc::POLLOUT, deadline)
+            .map_err(|error| protocol(format!("broker request write unavailable: {error}")))?;
+        match (&*writer).write(&framed[offset..]) {
+            Ok(0) => return Err(protocol("zero-length broker pipe write")),
+            Ok(written) => offset += written,
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    std::io::ErrorKind::WouldBlock | std::io::ErrorKind::Interrupted
+                ) => {}
+            Err(error) => return Err(protocol(format!("broker request write failed: {error}"))),
+        }
+    }
+    Ok(())
+}
+
+fn receive_frame(
+    reader: &std::fs::File,
+    deadline: std::time::Instant,
+) -> Result<Vec<u8>, ExecServerError> {
+    let mut prefix = [0_u8; 4];
+    read_pipe_exact(reader, &mut prefix, deadline)
+        .map_err(|e| protocol(format!("broker reply header failed: {e}")))?;
+    let len = u32::from_be_bytes(prefix) as usize;
+    if len == 0 || len > MAX_FRAME {
+        return Err(protocol("broker reply frame length is invalid"));
+    }
+    let mut bytes = vec![0; len];
+    read_pipe_exact(reader, &mut bytes, deadline)
+        .map_err(|e| protocol(format!("broker reply frame failed: {e}")))?;
+    Ok(bytes)
+}
+
+fn receive_frame_or_eof(
+    reader: &std::fs::File,
+    deadline: std::time::Instant,
+) -> std::io::Result<Option<Vec<u8>>> {
+    let mut prefix = [0_u8; 4];
+    loop {
+        ready(reader, libc::POLLIN, deadline)?;
+        match (&*reader).read(&mut prefix[..1]) {
+            Ok(0) => return Ok(None),
+            Ok(1) => break,
+            Ok(_) => unreachable!("single-byte read returned more than one byte"),
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    std::io::ErrorKind::WouldBlock | std::io::ErrorKind::Interrupted
+                ) => {}
+            Err(error) => return Err(error),
+        }
+    }
+    read_pipe_exact(reader, &mut prefix[1..], deadline)?;
+    let len = u32::from_be_bytes(prefix) as usize;
+    if len == 0 || len > MAX_FRAME {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "broker reply frame length is invalid",
+        ));
+    }
+    let mut bytes = vec![0; len];
+    read_pipe_exact(reader, &mut bytes, deadline)?;
+    Ok(Some(bytes))
+}
+
+fn verify_reply_eof(frame: Option<Vec<u8>>) -> Result<(), ExecServerError> {
+    if frame.is_some() {
+        Err(protocol("broker sent a frame after STOP_CONFIRMED"))
+    } else {
+        Ok(())
+    }
+}
+
+fn read_pipe_exact(
+    reader: &std::fs::File,
+    mut buffer: &mut [u8],
+    deadline: std::time::Instant,
+) -> std::io::Result<()> {
+    while !buffer.is_empty() {
+        ready(reader, libc::POLLIN, deadline)?;
+        match (&*reader).read(buffer) {
+            Ok(0) => return Err(std::io::Error::from(std::io::ErrorKind::UnexpectedEof)),
+            Ok(read) => buffer = &mut buffer[read..],
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    std::io::ErrorKind::WouldBlock | std::io::ErrorKind::Interrupted
+                ) => {}
+            Err(error) => return Err(error),
+        }
+    }
+    Ok(())
+}
+
+fn ready(file: &std::fs::File, mode: i16, deadline: std::time::Instant) -> std::io::Result<()> {
+    loop {
+        let remaining = deadline.saturating_duration_since(std::time::Instant::now());
+        if remaining.is_zero() {
+            return Err(std::io::Error::from(std::io::ErrorKind::TimedOut));
+        }
+        let ms = remaining.as_millis().clamp(1, i32::MAX as u128) as i32;
+        let mut pollfd = libc::pollfd {
+            fd: file.as_raw_fd(),
+            events: mode,
+            revents: 0,
+        };
+        // SAFETY: pollfd points to one initialized record holding a live file.
+        let result = unsafe { libc::poll(&mut pollfd, 1, ms) };
+        if result > 0 {
+            // A closed peer is handed to the next read/write as EOF/EPIPE.
+            return Ok(());
+        }
+        if result < 0 {
+            let error = std::io::Error::last_os_error();
+            if error.kind() != std::io::ErrorKind::Interrupted {
+                return Err(error);
+            }
+        }
+    }
+}
+
+fn nonblocking_pipe(fd: OwnedFd) -> Result<Arc<std::fs::File>, ExecServerError> {
+    let raw_fd = fd.as_raw_fd();
+    // SAFETY: raw_fd is live and the flag operations don't replace it.
+    let flags = unsafe { libc::fcntl(raw_fd, libc::F_GETFL) };
+    if flags < 0 || unsafe { libc::fcntl(raw_fd, libc::F_SETFL, flags | libc::O_NONBLOCK) } < 0 {
+        return Err(protocol("failed to make broker pipe nonblocking"));
+    }
+    Ok(Arc::new(std::fs::File::from(fd)))
+}
+
+struct UniqueFrame(Map<String, Value>);
+
+impl<'de> Deserialize<'de> for UniqueFrame {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct UniqueVisitor;
+        impl<'de> serde::de::Visitor<'de> for UniqueVisitor {
+            type Value = UniqueFrame;
+
+            fn expecting(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                formatter.write_str("one flat broker record with unique keys")
+            }
+
+            fn visit_map<A: serde::de::MapAccess<'de>>(
+                self,
+                mut input: A,
+            ) -> Result<UniqueFrame, A::Error> {
+                let mut fields = Map::new();
+                while let Some((key, value)) = input.next_entry::<String, Value>()? {
+                    if !(value.is_string() || value.is_number() || value.is_boolean())
+                        || fields.insert(key, value).is_some()
+                    {
+                        return Err(serde::de::Error::custom("invalid or repeated broker field"));
+                    }
+                }
+                Ok(UniqueFrame(fields))
+            }
+        }
+        deserializer.deserialize_map(UniqueVisitor)
+    }
+}
+
+fn parse_frame(
+    bytes: &[u8],
+    binding: &FrameBinding,
+    expected_sequence: u64,
+) -> Result<Value, ExecServerError> {
+    // Requests have canonical encoding for exact comparison by the helper.
+    // Replies may order keys differently, but a repeated field is ambiguous.
+    let UniqueFrame(object) = serde_json::from_slice(bytes)?;
+    let value = Value::Object(object);
+    let object = value
+        .as_object()
+        .ok_or_else(|| protocol("broker frame must be a JSON object"))?;
+    let expected_binding = binding_map(binding);
+    for (key, expected) in expected_binding {
+        if object.get(&key) != Some(&expected) {
+            return Err(protocol("broker frame identity mismatch"));
+        }
+    }
+    if u64_field(&value, "sequence") != Some(expected_sequence) {
+        return Err(protocol("broker reply sequence mismatch"));
+    }
+    let operation = value
+        .get("operation")
+        .and_then(Value::as_str)
+        .filter(|s| s.is_ascii())
+        .ok_or_else(|| protocol("broker operation is invalid"))?;
+    let mut allowed: Vec<String> = binding_map(binding)
+        .into_iter()
+        .map(|(key, _)| key)
+        .collect();
+    allowed.extend(["operation".into(), "sequence".into()]);
+    match operation {
+        "STARTED" | "STOP_CONFIRMED" => allowed.extend(["pid".into(), "start_ticks".into()]),
+        "OUTPUT" => allowed.extend(["stream".into(), "data".into()]),
+        "EXIT" => allowed.extend(["pid".into(), "start_ticks".into(), "exit_code".into()]),
+        "REFUSED" => allowed.push("reason".into()),
+        _ => return Err(protocol("unexpected broker operation")),
+    }
+    if object.keys().any(|key| !allowed.contains(key)) {
+        return Err(protocol("broker frame contains an unknown field"));
+    }
+    Ok(value)
+}
+
+fn canonicalize(value: Value) -> Value {
+    match value {
+        Value::Object(object) => {
+            let sorted: std::collections::BTreeMap<_, _> = object
+                .into_iter()
+                .map(|(key, value)| (key, canonicalize(value)))
+                .collect();
+            Value::Object(sorted.into_iter().collect())
+        }
+        Value::Array(array) => Value::Array(array.into_iter().map(canonicalize).collect()),
+        scalar => scalar,
+    }
+}
+
+fn binding_map(binding: &FrameBinding) -> Map<String, Value> {
+    serde_json::to_value(binding)
+        .expect("FrameBinding is serializable")
+        .as_object()
+        .expect("binding object")
+        .clone()
+}
+
+fn validate_binding(binding: &FrameBinding) -> Result<(), ExecServerError> {
+    let strings = [
+        &binding.attempt_id,
+        &binding.binding_digest,
+        &binding.channel_nonce,
+        &binding.file_sha256,
+        &binding.grant_id,
+        &binding.holder_sha256,
+        &binding.holder_incarnation,
+        &binding.operation_id,
+        &binding.permit_id,
+        &binding.permit_revision,
+        &binding.source_commit,
+        &binding.source_tree,
+        &binding.tool_call_id,
+    ];
+    if strings.iter().any(|s| s.is_empty() || !s.is_ascii()) || binding.deadline_ms == 0 {
+        return Err(protocol(
+            "broker binding contains an invalid identity or deadline",
+        ));
+    }
+    if serde_json::to_vec(&binding_map(binding))?.len() > 2000 {
+        return Err(protocol("broker frame identity exceeds its bounded size"));
+    }
+    Ok(())
+}
+
+fn validate_exec_params(params: &ExecParams) -> Result<(), ExecServerError> {
+    if params.tty
+        || params.pipe_stdin
+        || params.shell_snapshot.is_some()
+        || params.env_policy.is_some()
+        || !params.env.is_empty()
+        || params.arg0.is_some()
+        || params.enforce_managed_network
+        || params.managed_network.is_some()
+        || params.network_proxy.is_some()
+        || params.sandbox.is_some()
+    {
+        return Err(protocol(
+            "exec request asks for a forbidden process capability",
+        ));
+    }
+    Ok(())
+}
+
+fn deadlines(deadline_ms: u64) -> Result<(Instant, Instant), ExecServerError> {
+    let mut now = std::mem::MaybeUninit::<libc::timespec>::uninit();
+    // SAFETY: `clock_gettime` initializes `now` on success.
+    if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, now.as_mut_ptr()) } != 0 {
+        return Err(protocol("failed to read CLOCK_MONOTONIC"));
+    }
+    // SAFETY: the successful `clock_gettime` call initialized the value.
+    let now = unsafe { now.assume_init() };
+    let now_ms = (now.tv_sec as u64)
+        .saturating_mul(1000)
+        .saturating_add(now.tv_nsec as u64 / 1_000_000);
+    let remaining = deadline_ms
+        .checked_sub(now_ms)
+        .ok_or_else(|| protocol("broker permit deadline expired"))?;
+    if remaining > 60_000 || remaining <= STOP_RESERVE.as_millis() as u64 {
+        return Err(protocol(
+            "broker permit deadline is outside the bounded cleanup window",
+        ));
+    }
+    let deadline = Instant::now() + Duration::from_millis(remaining);
+    let start_deadline = deadline - STOP_RESERVE;
+    Ok((
+        start_deadline.min(Instant::now() + MAX_OPERATION_TIME),
+        deadline,
+    ))
+}
+
+fn u32_field(value: &Value, key: &str) -> Option<u32> {
+    value.get(key)?.as_u64().and_then(|n| u32::try_from(n).ok())
+}
+fn u64_field(value: &Value, key: &str) -> Option<u64> {
+    value.get(key)?.as_u64()
+}
+fn is_digest(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+}
+fn protocol(message: impl Into<String>) -> ExecServerError {
+    ExecServerError::Protocol(message.into())
+}
+
+impl ExecProcess for SymphonyExecProcess {
+    fn process_id(&self) -> &ProcessId {
+        &self.inner.process_id
+    }
+    fn subscribe_wake(&self) -> watch::Receiver<u64> {
+        self.inner.wake_tx.subscribe()
+    }
+    fn subscribe_events(&self) -> ExecProcessEventReceiver {
+        self.inner.events.subscribe()
+    }
+
+    fn read(
+        &self,
+        after_seq: Option<u64>,
+        max_bytes: Option<usize>,
+        wait_ms: Option<u64>,
+    ) -> ExecProcessFuture<'_, ReadResponse> {
+        Box::pin(async move {
+            let after = after_seq.unwrap_or(0);
+            let max = max_bytes.unwrap_or(usize::MAX);
+            let deadline = Instant::now() + Duration::from_millis(wait_ms.unwrap_or(0));
+            loop {
+                let notified = self.inner.changed.notified();
+                let state = self.inner.state.lock().await;
+                let mut chunks = Vec::new();
+                let mut total: usize = 0;
+                for chunk in state.output.iter().filter(|chunk| chunk.seq > after) {
+                    let size = chunk.chunk.0.len();
+                    if !chunks.is_empty() && total.saturating_add(size) > max {
+                        break;
+                    }
+                    total += size;
+                    chunks.push(chunk.clone());
+                }
+                let response = ReadResponse {
+                    chunks,
+                    next_seq: state.next_seq,
+                    exited: state.exit_code.is_some(),
+                    exit_code: state.exit_code,
+                    closed: state.closed,
+                    failure: state.failure.clone(),
+                    sandbox_denied: false,
+                };
+                let has_data = !response.chunks.is_empty()
+                    || response.exited
+                    || response.closed
+                    || response.failure.is_some();
+                drop(state);
+                if has_data || Instant::now() >= deadline {
+                    return Ok(response);
+                }
+                if timeout_at(deadline, notified).await.is_err() {
+                    return Ok(response);
+                }
+            }
+        })
+    }
+
+    fn write(&self, _chunk: Vec<u8>) -> ExecProcessFuture<'_, WriteResponse> {
+        Box::pin(async { Err(protocol("stdin is forbidden by the broker permit")) })
+    }
+
+    fn signal(&self, _signal: ProcessSignal) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async {
+            Err(protocol(
+                "signals are forbidden; use operation-scoped terminate",
+            ))
+        })
+    }
+
+    fn terminate(&self) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async move {
+            let should_send = {
+                let mut state = self.inner.state.lock().await;
+                if state.stop_confirmed {
+                    return Ok(());
+                }
+                if let Some(error) = &state.failure {
+                    return Err(protocol(error.clone()));
+                }
+                if state.stop_sent || state.stop_sending {
+                    false
+                } else {
+                    if state.started.is_none() {
+                        return Err(protocol("cannot stop before correlated STARTED"));
+                    }
+                    state.stop_sending = true;
+                    true
+                }
+            };
+            if should_send {
+                let mut state = self.inner.state.lock().await;
+                if let Some(error) = state.failure.clone() {
+                    state.stop_sending = false;
+                    return Err(protocol(error));
+                }
+                if let Err(error) = send_frame(&self.inner, "STOP_REQUEST", 2, false).await {
+                    state.stop_sending = false;
+                    let message = format!("STOP_REQUEST write failed: {error}");
+                    state.failure = Some(message.clone());
+                    self.inner.events.publish(ExecProcessEvent::Failed(message));
+                    self.inner
+                        .wake_tx
+                        .send_modify(|seq| *seq = seq.saturating_add(1));
+                    drop(state);
+                    self.inner.request.lock().await.take();
+                    self.inner.changed.notify_waiters();
+                    return Err(error);
+                }
+                state.stop_sent = true;
+                state.stop_sending = false;
+                drop(state);
+                self.inner.request.lock().await.take();
+                self.inner.changed.notify_waiters();
+            }
+            loop {
+                let notified = self.inner.changed.notified();
+                let state = self.inner.state.lock().await;
+                if state.stop_confirmed {
+                    return Ok(());
+                }
+                if let Some(error) = &state.failure {
+                    return Err(protocol(error.clone()));
+                }
+                drop(state);
+                timeout_at(self.inner.deadline, notified)
+                    .await
+                    .map_err(|_| {
+                        protocol("STOP_CONFIRMED deadline expired; process state is uncertain")
+                    })?;
+            }
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{ProcessState, stop_confirmation_ready, verify_reply_eof};
+
+    #[test]
+    fn stop_confirmation_requires_started_exit_and_sent_request() {
+        let identity = (42, 9001);
+        let mut state = ProcessState {
+            started: Some(identity),
+            ..ProcessState::default()
+        };
+        assert!(!stop_confirmation_ready(&state, identity));
+
+        state.exit_code = Some(0);
+        assert!(!stop_confirmation_ready(&state, identity));
+
+        state.stop_sent = true;
+        assert!(stop_confirmation_ready(&state, identity));
+    }
+
+    #[test]
+    fn stop_confirmation_rejects_mismatches_and_prior_terminal_state() {
+        let identity = (42, 9001);
+        let mut state = ProcessState {
+            started: Some(identity),
+            exit_code: Some(0),
+            stop_sent: true,
+            ..ProcessState::default()
+        };
+        assert!(!stop_confirmation_ready(&state, (43, 9001)));
+        assert!(!stop_confirmation_ready(&state, (42, 9002)));
+
+        state.stop_confirmed = true;
+        assert!(!stop_confirmation_ready(&state, identity));
+        state.stop_confirmed = false;
+        state.closed = true;
+        assert!(!stop_confirmation_ready(&state, identity));
+        state.closed = false;
+        state.failure = Some("previous failure".into());
+        assert!(!stop_confirmation_ready(&state, identity));
+    }
+
+    #[test]
+    fn duplicate_terminal_frame_before_eof_is_rejected() {
+        assert!(verify_reply_eof(Some(b"{\"operation\":\"STOP_CONFIRMED\"}".to_vec())).is_err());
+        assert!(verify_reply_eof(None).is_ok());
+    }
+}
