+/// Install the already sealed broker selection for the selected two-request turn.
+/// This consumes the same one-use descriptor as the standalone B diagnostic.
+fn install_selected_broker(ctx: &SymphonyContext, selection: &Value, deadline: u64) -> Result<()> {
+    use codex_core::symphony_boundary::{broker_argv, install_broker};
+    use codex_exec_server::ExecParams;
+    use codex_exec_server::{BrokerPermit, FrameBinding, SymphonyExecBackend};
+    use std::os::fd::{FromRawFd, OwnedFd};
+    const BROKER: &str = "SYMPHONY_BROKER_REFUSED";
+    keys(
+        selection,
+        &[
+            "binding",
+            "request_device",
+            "request_inode",
+            "reply_device",
+            "reply_inode",
+            "broker_sha256",
+            "broker_permit_sha256",
+            "mode",
+        ],
+    )?;
+    let binding: FrameBinding =
+        serde_json::from_value(selection.get("binding").cloned().ok_or(BROKER)?)
+            .map_err(|_| BROKER)?;
+    let exact = [
+        (&binding.attempt_id, &ctx.attempt_id),
+        (&binding.binding_digest, &ctx.binding_id),
+        (&binding.holder_sha256, &ctx.holder_sha256),
+        (&binding.grant_id, &ctx.grant_id),
+        (&binding.source_commit, &ctx.source_commit),
+        (&binding.source_tree, &ctx.source_tree),
+    ];
+    if exact.iter().any(|(bound, selected)| bound != selected)
+        || binding.deadline_ms != deadline
+        || binding.permit_revision != "1"
+        || text(selection, "mode")? != "run"
+        || ["broker_sha256", "broker_permit_sha256"]
+            .iter()
+            .any(|field| text(selection, field).map_or(true, |value| !lower_sha256(&value)))
+    {
+        return Err(BROKER);
+    }
+    let argv = broker_argv();
+    let cwd =
+        codex_utils_path_uri::PathUri::from_host_native_path(&ctx.workspace).map_err(|_| BROKER)?;
+    let argv_sha256 = hash(&serde_json::to_vec(&argv).map_err(|_| BROKER)?);
+    let cwd_sha256 = hash(ctx.workspace.to_str().ok_or(BROKER)?.as_bytes());
+    let params = ExecParams {
+        process_id: codex_exec_server::ProcessId::new(binding.operation_id.clone()),
+        metadata: None,
+        argv,
+        cwd,
+        env_policy: None,
+        shell_snapshot: None,
+        env: Default::default(),
+        tty: false,
+        pipe_stdin: false,
+        arg0: None,
+        sandbox: None,
+        enforce_managed_network: false,
+        managed_network: None,
+        network_proxy: None,
+    };
+    let request = unsafe { OwnedFd::from_raw_fd(5) };
+    let reply = unsafe { OwnedFd::from_raw_fd(6) };
+    let backend = Arc::new(
+        SymphonyExecBackend::new(
+            BrokerPermit {
+                expected_params: params.clone(),
+                binding: binding.clone(),
+                selector: "planner_input_head8".into(),
+                argv_sha256,
+                cwd_sha256,
+            },
+            request,
+            reply,
+        )
+        .map_err(|_| BROKER)?,
+    );
+    install_broker(ctx, backend, params, binding.tool_call_id).map_err(|_| BROKER)
+}
+
+fn lower_sha256(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+/// The sealed diagnostic uses the actual exec-server contract without admitting a
+/// Planner turn or enabling any model service. Native ownership still owns stop.
+fn run_broker(ctx: &SymphonyContext, selection: Value, deadline: u64) -> Result<()> {
+    use base64::Engine as _;
+    use base64::engine::general_purpose::STANDARD;
+    use codex_core::symphony_boundary::{
+        BROKER_COMMAND, broker_argv, dispatch_broker_tool, install_broker,
+    };
+    use codex_exec_server::ExecParams;
+    use codex_exec_server::ExecProcessEvent;
+    use codex_exec_server::ProcessId;
+    use codex_exec_server::{BrokerPermit, FrameBinding, SymphonyExecBackend};
+    use std::os::fd::{FromRawFd, OwnedFd};
+
+    const BROKER: &str = "SYMPHONY_BROKER_REFUSED";
+    keys(
+        &selection,
+        &[
+            "binding",
+            "request_device",
+            "request_inode",
+            "reply_device",
+            "reply_inode",
+            "broker_sha256",
+            "broker_permit_sha256",
+            "mode",
+        ],
+    )?;
+    let binding: FrameBinding =
+        serde_json::from_value(selection.get("binding").cloned().ok_or(BROKER)?)
+            .map_err(|_| BROKER)?;
+    let exact = [
+        (&binding.attempt_id, &ctx.attempt_id),
+        (&binding.binding_digest, &ctx.binding_id),
+        (&binding.holder_sha256, &ctx.holder_sha256),
+        (&binding.grant_id, &ctx.grant_id),
+        (&binding.source_commit, &ctx.source_commit),
+        (&binding.source_tree, &ctx.source_tree),
+    ];
+    if exact.iter().any(|(bound, selected)| bound != selected)
+        || binding.deadline_ms != deadline
+        || ctx.role != "Planner"
+        || ctx.wait_for_interrupt
+        || binding.permit_revision != "1"
+        || ["broker_sha256", "broker_permit_sha256"]
+            .iter()
+            .any(|field| {
+                text(&selection, field).map_or(true, |value| {
+                    value.len() != 64
+                        || !value
+                            .bytes()
+                            .all(|byte| matches!(byte, b'0'..=b'9' | b'a'..=b'f'))
+                })
+            })
+    {
+        return Err(BROKER);
+    }
+    let argv = broker_argv();
+    let cwd =
+        codex_utils_path_uri::PathUri::from_host_native_path(&ctx.workspace).map_err(|_| BROKER)?;
+    let argv_sha256 = hash(&serde_json::to_vec(&argv).map_err(|_| BROKER)?);
+    let cwd_sha256 = hash(ctx.workspace.to_str().ok_or(BROKER)?.as_bytes());
+    let params = ExecParams {
+        process_id: ProcessId::new(binding.operation_id.clone()),
+        metadata: None,
+        argv,
+        cwd,
+        env_policy: None,
+        shell_snapshot: None,
+        env: Default::default(),
+        tty: false,
+        pipe_stdin: false,
+        arg0: None,
+        sandbox: None,
+        enforce_managed_network: false,
+        managed_network: None,
+        network_proxy: None,
+    };
+    let cancel = match text(&selection, "mode")?.as_str() {
+        "wait_for_stop" => true,
+        "run" | "observe_helper_loss" => false,
+        _ => return Err(BROKER),
+    };
+    let operation = binding.operation_id.clone();
+    let call_id = binding.tool_call_id.clone();
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_time()
+        .build()
+        .map_err(|_| BROKER)?;
+    runtime.block_on(async {
+        let request = unsafe { OwnedFd::from_raw_fd(5) };
+        let reply = unsafe { OwnedFd::from_raw_fd(6) };
+        let backend = Arc::new(
+            SymphonyExecBackend::new(
+                BrokerPermit {
+                    expected_params: params.clone(),
+                    binding,
+                    selector: "planner_input_head8".into(),
+                    argv_sha256,
+                    cwd_sha256,
+                },
+                request,
+                reply,
+            )
+            .map_err(|_| BROKER)?,
+        );
+        install_broker(ctx, backend.clone(), params, call_id.clone()).map_err(|_| BROKER)?;
+        emit(
+            json!({"ready": true, "binding": ctx.binding_id, "qualified_host": false,
+                   "controls": {"protected_codex_entry": true, "broker_selftest": true,
+                                "fork_denied": true, "exec_denied": true}}),
+            deadline,
+        )?;
+        let args =
+            json!({"cmd": BROKER_COMMAND, "workdir": ctx.workspace, "login": false, "tty": false});
+        let arguments = args.to_string();
+        let wrong_args = [
+            json!({"cmd": BROKER_COMMAND, "workdir": ctx.workspace, "login": false, "tty": true}),
+            json!({"cmd": BROKER_COMMAND, "workdir": ctx.home, "login": false, "tty": false}),
+            json!({"cmd": "/usr/bin/head -n 8 -- README", "workdir": ctx.workspace, "login": false, "tty": false}),
+        ];
+        if dispatch_broker_tool("write_stdin", &call_id, arguments.clone())
+            .await.is_ok()
+            || dispatch_broker_tool("exec_command", "wrong-call", arguments.clone())
+                .await.is_ok()
+        {
+            return Err(BROKER);
+        }
+        for args in wrong_args {
+            if dispatch_broker_tool("exec_command", &call_id, args.to_string())
+                .await.is_ok()
+            {
+                return Err(BROKER);
+            }
+        }
+        let started = dispatch_broker_tool("exec_command", &call_id, arguments.clone())
+            .await
+            .map_err(|_| BROKER)?;
+        let identity = backend.started_identity().await.ok_or(BROKER)?;
+        let process = started.process;
+        let mut events = process.subscribe_events();
+        if cancel {
+            // The host has to observe the live child before requesting stop.
+            // This held synthetic path accepts only a single cancellation byte.
+            poll(0, libc::POLLIN, deadline)?;
+            let mut command = 0_u8;
+            if unsafe { libc::read(0, (&mut command as *mut u8).cast(), 1) } != 1 || command != b'C'
+            {
+                return Err(BROKER);
+            }
+            process.terminate().await.map_err(|_| BROKER)?;
+        }
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+        let mut exit_status = None;
+        loop {
+            let event = tokio::time::timeout(remaining(deadline)?, events.recv())
+                .await
+                .map_err(|_| "SYMPHONY_DEADLINE")?
+                .map_err(|_| BROKER)?;
+            match event {
+                ExecProcessEvent::Output(chunk) => match chunk.stream {
+                    codex_exec_server::ExecOutputStream::Stdout => {
+                        stdout.extend_from_slice(chunk.chunk.0.as_slice())
+                    }
+                    codex_exec_server::ExecOutputStream::Stderr => {
+                        stderr.extend_from_slice(chunk.chunk.0.as_slice())
+                    }
+                    _ => return Err(BROKER),
+                },
+                ExecProcessEvent::Exited { exit_code, .. } => exit_status = Some(exit_code),
+                ExecProcessEvent::Closed { .. } => break,
+                ExecProcessEvent::Failed(_) => return Err(BROKER),
+            }
+            if stdout.len() + stderr.len() > 16_384 {
+                return Err(BROKER);
+            }
+        }
+        if dispatch_broker_tool("exec_command", &call_id, arguments)
+            .await
+            .is_ok()
+        {
+            return Err(BROKER);
+        }
+        emit(
+            json!({"operation_id": operation, "status": "stop_verified",
+                    "pid": identity.pid, "start_ticks": identity.start_ticks,
+                    "exit_status": exit_status.ok_or(BROKER)?,
+                    "stdout_sha256": hash(&stdout), "stderr_sha256": hash(&stderr),
+                    "stdout": STANDARD.encode(&stdout), "stderr": STANDARD.encode(&stderr),
+                    "duplicate_refused": true, "cancelled": cancel,
+                    "route": "selected_exec_command", "other_tool_refused": true,
+                    "wrong_arguments_refused": true, "wrong_call_id_refused": true}),
+            deadline,
+        )
+    })
+}
+
+async fn session(ctx: Arc<SymphonyContext>, deadline: u64) -> Result<()> {
+    let mut config = Config::from_symphony_context(&ctx)
+        .await
+        .map_err(|_| "SYMPHONY_CONFIG_REFUSED")?;
+    if ctx.provider_nonce.is_some() {
+        config
+            .permissions
+            .set_permission_profile_from_session_snapshot(
+                codex_protocol::models::PermissionProfileSnapshot::active(
+                    codex_protocol::models::PermissionProfile::read_only(),
+                    codex_protocol::models::ActivePermissionProfile::new("symphony_planner_read"),
+                ),
+            )
+            .map_err(|_| "SYMPHONY_CONFIG_REFUSED")?;
+    }
+    let manager = ThreadManager::new_strict(Arc::clone(&ctx), config)
+        .map_err(|_| "SYMPHONY_STRICT_SERVICES_UNAVAILABLE")?;
+    emit(
+        json!({"ready":true,"binding":ctx.binding_id,"qualified_host":false,
+        "version":env!("CARGO_PKG_VERSION"),"controls":{
+            "protected_codex_entry":true,"tokio_thread":true,"fork_denied":true,
+            "exec_denied":true,"ptrace_denied":true,"inet_socket_denied":true,
+            "process_clone_denied":true,"credential_fds_absent":true,"fresh_home":true}}),
+        deadline,
+    )?;
+    let mut total = 0;
+    let mut initialized = false;
+    let mut acknowledged = false;
+    let mut thread = None;
+    let mut admitted = false;
+    let mut request_ids = std::collections::HashSet::new();
+    let outcome = async {
+        while let Some(message) = read(deadline, &mut total)? {
+            keys(&message, &["id", "method", "params"])?;
+            let method = text(&message, "method")?;
+            let params = message.get("params").cloned().unwrap_or_else(|| json!({}));
+            if method == "initialized" && initialized && !acknowledged && message.get("id").is_none() {
+                keys(&params, &[])?;
+                acknowledged = true;
+                continue;
+            }
+            let id = message.get("id").filter(|id| id.is_i64() || id.as_str().is_some_and(|s| s.len() <= 64))
+                .cloned().ok_or(REFUSED)?;
+            if !request_ids.insert(id.to_string()) { return Err(REFUSED); }
+            match method.as_str() {
+                "initialize" if !initialized => {
+                    keys(&params, &["clientInfo"])?;
+                    keys(params.get("clientInfo").ok_or(REFUSED)?, &["name", "version", "title"])?;
+                    let _: codex_app_server_protocol::InitializeParams = serde_json::from_value(params).map_err(|_| REFUSED)?;
+                    emit(json!({"id":id,"result":{"userAgent":"codex-app-server protected synthetic",
+                        "codexHome":ctx.codex_home,"platformFamily":"unix","platformOs":"linux"}}), deadline)?;
+                    initialized = true;
+                }
+                "thread/start" if acknowledged && thread.is_none() => {
+                    keys(&params, &[])?;
+                    let created = tokio::time::timeout(remaining(deadline)?, manager.start_strict_thread())
+                        .await.map_err(|_| "SYMPHONY_DEADLINE")?.map_err(|_| "SYMPHONY_THREAD_REFUSED")?;
+                    let thread_id = created.thread_id.to_string();
+                    let wire = wire_thread(&created.session_configured)?;
+                    let configured = &created.session_configured;
+                    let response = codex_app_server_protocol::ThreadStartResponse {
+                        thread: wire.clone(), model: configured.model.clone(),
+                        model_provider: configured.model_provider_id.clone(), service_tier: None,
+                        disabled_plugin_ids: Vec::new(), cwd: configured.cwd.clone(),
+                        runtime_workspace_roots: vec![configured.cwd.clone()], instruction_sources: Vec::new(),
+                        approval_policy: configured.approval_policy.clone().into(),
+                        approvals_reviewer: configured.approvals_reviewer.into(),
+                        sandbox: configured.permission_profile.to_legacy_sandbox_policy(&ctx.workspace)
+                            .map_err(|_| REFUSED)?.into(),
+                        active_permission_profile: configured.active_permission_profile.clone().map(Into::into),
+                        reasoning_effort: configured.reasoning_effort.clone(),
+                        multi_agent_mode: codex_protocol::config_types::MultiAgentMode::ExplicitRequestOnly,
+                    };
+                    emit(json!({"id":id,"result":response}), deadline)?;
+                    emit(json!({"method":"thread/started","params":{"thread":wire}}), deadline)?;
+                    thread = Some((thread_id, created.thread));
+                }
+                "turn/start" if !admitted => {
+                    keys(&params, &["threadId", "input"])?;
+                    let (thread_id, core) = thread.as_ref().ok_or(REFUSED)?;
+                    if text(&params, "threadId")? != *thread_id { return Err(REFUSED); }
+                    let input = params.get("input").and_then(Value::as_array).ok_or(REFUSED)?;
+                    if input.len() != 1 { return Err(REFUSED); }
+                    keys(&input[0], &["type", "text"])?;
+                    if text(&input[0], "type")? != "text" || text(&input[0], "text")? != ctx.prompt_text {
+                        return Err(REFUSED);
+                    }
+                    admitted = true;
+                    let request = TurnInputRequest::new(TurnInput::UserInput {
+                        content: vec![UserInput::Text { text:ctx.prompt_text.clone(), text_elements:Vec::new() }], client_id:None,
+                    });
+                    let (reply, response) = tokio::sync::oneshot::channel();
+                    core.submit(Op::TurnInput { request:Box::new(request), mode:TurnInputMode::StartIfIdle, reply })
+                        .await.map_err(|_| REFUSED)?;
+                    let actual = tokio::time::timeout(remaining(deadline)?, response).await
+                        .map_err(|_| "SYMPHONY_DEADLINE")?.map_err(|_| REFUSED)?.map_err(|_| REFUSED)?;
+                    let TurnInputSubmission::Started { turn_id, root_turn_id } = actual else { return Err(REFUSED); };
+                    if ctx.provider_nonce.is_some() {
+                        codex_core::symphony_boundary::transport::set_rpc_ids(thread_id, &turn_id)
+                            .map_err(|_| "SYMPHONY_PROVIDER_CONTEXT_INVALID")?;
+                    }
+                    emit(json!({"id":id,"result":codex_app_server_protocol::TurnStartResponse {
+                        turn:wire_turn(turn_id.clone(), Some(root_turn_id),
+                            codex_app_server_protocol::TurnStatus::InProgress, None, None, None, None)
+                    }}), deadline)?;
+                    let mut started = false;
+                    let mut error_seen = false;
+                    let mut final_answer: Option<String> = None;
+                    loop {
+                        // Poll only the already-open control pipe. No I/O reactor or
+                        // background reader is created in the protected holder.
+                        let mut input = libc::pollfd { fd: 0, events: libc::POLLIN, revents: 0 };
+                        let observed = unsafe { libc::poll(&mut input, 1, 0) };
+                        if observed < 0 { return Err(REFUSED); }
+                        if input.revents & libc::POLLIN != 0 {
+                            let interrupt = read(deadline, &mut total)?.ok_or(REFUSED)?;
+                            keys(&interrupt, &["id", "method", "params"])?;
+                            if text(&interrupt, "method")? != "turn/interrupt" { return Err(REFUSED); }
+                            let interrupt_id = interrupt.get("id")
+                                .filter(|id| id.is_i64() || id.as_str().is_some_and(|s| s.len() <= 64))
+                                .cloned().ok_or(REFUSED)?;
+                            if !request_ids.insert(interrupt_id.to_string()) { return Err(REFUSED); }
+                            let params = interrupt.get("params").ok_or(REFUSED)?;
+                            keys(params, &["threadId", "turnId"])?;
+                            if text(params, "threadId")? != *thread_id || text(params, "turnId")? != turn_id {
+                                return Err(REFUSED);
+                            }
+                            core.submit(Op::Interrupt).await.map_err(|_| REFUSED)?;
+                            emit(json!({"id":interrupt_id,"result":
+                                codex_app_server_protocol::TurnInterruptResponse {}}), deadline)?;
+                        }
+                        let event = match tokio::time::timeout(
+                            remaining(deadline)?.min(Duration::from_millis(5)), core.next_event()).await {
+                            Ok(event) => event.map_err(|_| REFUSED)?,
+                            Err(_) => { remaining(deadline)?; continue; }
+                        };
+                        if event.id != turn_id { return Err("SYMPHONY_CORE_EVIDENCE_REFUSED"); }
+                        match event.msg {
+                            EventMsg::TurnStarted(actual) if !started && actual.turn_id == turn_id => {
+                                started = true;
+                                emit(json!({"method":"turn/started","params":{"threadId":thread_id,
+                                    "turn":wire_turn(actual.turn_id, actual.root_turn_id,
+                                        codex_app_server_protocol::TurnStatus::InProgress, None,
+                                        actual.started_at, None, None)}}), deadline)?;
+                            }
+                            EventMsg::Error(error) if started && !error_seen && error.message == PROVIDER => {
+                                error_seen = true;
+                                emit(json!({"method":"error","params":codex_app_server_protocol::ErrorNotification {
+                                    thread_id:thread_id.clone(), turn_id:turn_id.clone(), will_retry:false,
+                                    error:codex_app_server_protocol::TurnError {
+                                        message:error.message,
+                                        codex_error_info:error.codex_error_info.map(Into::into),
+                                        additional_details:None, misalignment:None,
+                                    }
+                                }}), deadline)?;
+                            }
+                            EventMsg::ItemCompleted(item) if started && ctx.provider_nonce.is_some() => {
+                                let final_text = match &item.item {
+                                    codex_protocol::items::TurnItem::AgentMessage(message)
+                                        if message.phase == Some(codex_protocol::models::MessagePhase::FinalAnswer) => {
+                                            if final_answer.is_some() { return Err("SYMPHONY_FINAL_ANSWER_REFUSED"); }
+                                            Some(message.content.iter().map(|part| match part {
+                                                codex_protocol::items::AgentMessageContent::Text { text } => text.as_str(),
+                                            }).collect::<String>())
+                                        }
+                                    _ => None,
+                                };
+                                if let Some(text) = final_text.clone() { final_answer = Some(text); }
+                                let notification = codex_app_server_protocol::ItemCompletedNotification {
+                                    thread_id: thread_id.clone(),
+                                    turn_id: turn_id.clone(),
+                                    item: codex_app_server_protocol::ThreadItem::from(item.item),
+                                    completed_at_ms: item.completed_at_ms,
+                                };
+                                emit(json!({"method":"item/completed","params":notification}), deadline)?;
+                            }
+                            EventMsg::TurnComplete(actual) if started && !error_seen
+                                && ctx.provider_nonce.is_some()
+                                && actual.turn_id == turn_id
+                                && actual.error.is_none()
+                                && actual.last_agent_message.as_deref() == final_answer.as_deref()
+                                && final_answer.is_some() => {
+                                emit(json!({"method":"turn/completed","params":{"threadId":thread_id,
+                                    "turn":wire_turn(actual.turn_id, actual.root_turn_id,
+                                        codex_app_server_protocol::TurnStatus::Completed, None,
+                                        actual.started_at, actual.completed_at, actual.duration_ms)}}), deadline)?;
+                                break;
+                            }
+                            EventMsg::TurnComplete(actual) if started && error_seen && actual.turn_id == turn_id
+                                && actual.last_agent_message.is_none()
+                                && actual.error.as_ref().is_some_and(|error| error.message == PROVIDER) => {
+                                emit(json!({"method":"turn/completed","params":{"threadId":thread_id,
+                                    "turn":wire_turn(actual.turn_id, actual.root_turn_id,
+                                        codex_app_server_protocol::TurnStatus::Failed, actual.error,
+                                        actual.started_at, actual.completed_at, actual.duration_ms)}}), deadline)?;
+                                break;
+                            }
+                            EventMsg::TurnAborted(actual) if started && !error_seen && actual.error.is_none()
+                                && actual.turn_id.as_deref() == Some(&turn_id) => {
+                                emit(json!({"method":"turn/completed","params":{"threadId":thread_id,
+                                    "turn":wire_turn(turn_id.clone(), actual.root_turn_id,
+                                        codex_app_server_protocol::TurnStatus::Interrupted, actual.error,
+                                        actual.started_at, actual.completed_at, actual.duration_ms)}}), deadline)?;
+                                break;
+                            }
+                            _ => return Err("SYMPHONY_CORE_EVIDENCE_REFUSED"),
+                        }
+                    }
+                }
+                _ => return Err(REFUSED),
+            }
+        }
+        Ok(())
+    }.await;
+    // No normal-success return is stop proof. The caller still requires the
+    // native namespace/PID/port observations owned by C03.
+    let stopped = tokio::time::timeout(
+        remaining(deadline)?,
+        manager.shutdown_all_threads_bounded(remaining(deadline)?),
+    )
+    .await
+    .map_err(|_| "SYMPHONY_DISPOSAL_UNCONFIRMED")?;
+    if codex_core::symphony_boundary::stop_unconfirmed()
+        || !stopped.submit_failed.is_empty()
+        || !stopped.timed_out.is_empty()
+        || thread.as_ref().is_some_and(|(id, _)| {
+            !stopped
+                .completed
+                .iter()
+                .any(|actual| actual.to_string() == *id)
+        })
+    {
+        return Err("SYMPHONY_DISPOSAL_UNCONFIRMED");
+    }
+    outcome
+}
