new file mode 100644
index 00000000..af6e5d7c
--- /dev/null
+++ b/codex-rs/core/src/symphony_boundary/transport.rs
@@ -0,0 +1,1271 @@
+//! Fixed synthetic Responses transport for the selected holder.
+//!
+//! The transport accepts only prepared Responses POST requests. It never opens
+//! a socket and never places authorization or request content on the host pipe.
+
+use std::sync::{Arc, Mutex, OnceLock};
+
+use base64::Engine as _;
+use codex_api::{AuthProvider, Provider, RetryConfig, SharedAuthProvider};
+use codex_client::{ByteStream, HttpTransport, Request, Response, StreamResponse, TransportError};
+use futures::stream;
+use http::{HeaderMap, HeaderValue, Method, StatusCode, header};
+use serde_json::{Value, json};
+
+const FRAME_LIMIT: usize = 8192;
+const CHUNK_TEXT_LIMIT: usize = 6144;
+const RESPONSE_LIMIT: usize = 262144;
+const MODEL: &str = "synthetic-planner-v1";
+const URL: &str = "https://api.openai.com/v1/responses";
+type DigestFn = fn(&[u8]) -> String;
+
+struct Secret(Vec<u8>);
+impl Drop for Secret {
+    fn drop(&mut self) {
+        for byte in &mut self.0 {
+            // SAFETY: volatile writes prevent the compiler from eliding the wipe.
+            unsafe { std::ptr::write_volatile(byte, 0) };
+        }
+    }
+}
+
+struct State {
+    token: Secret,
+    nonce: String,
+    fixture_sha256: String,
+    context_digest: String,
+    deadline_ms: u64,
+    digest: DigestFn,
+    ordinal: u64,
+    sequence: u64,
+    fixture_sequence: u64,
+    thread_id: Option<String>,
+    turn_id: Option<String>,
+    response_id: Option<String>,
+    tool_call_id: Option<String>,
+    prior_terminal: bool,
+    workspace: String,
+}
+
+static STATE: OnceLock<Mutex<Option<State>>> = OnceLock::new();
+
+pub fn enabled() -> bool {
+    STATE.get().is_some()
+}
+
+pub fn install(
+    token: Vec<u8>,
+    nonce: String,
+    fixture_sha256: String,
+    context_digest: String,
+    deadline_ms: u64,
+    digest: DigestFn,
+    workspace: String,
+) -> Result<(), &'static str> {
+    install_into(
+        &STATE,
+        State {
+            token: Secret(token),
+            nonce,
+            fixture_sha256,
+            context_digest,
+            deadline_ms,
+            digest,
+            ordinal: 0,
+            sequence: 0,
+            fixture_sequence: 0,
+            thread_id: None,
+            turn_id: None,
+            response_id: None,
+            tool_call_id: None,
+            prior_terminal: false,
+            workspace,
+        },
+    )
+}
+
+fn install_into(
+    slot: &OnceLock<Mutex<Option<State>>>,
+    candidate: State,
+) -> Result<(), &'static str> {
+    const INVALID: &str = "SYMPHONY_PROVIDER_CONTEXT_INVALID";
+    let token = &candidate.token.0;
+    if token.len() != 50
+        || !token.starts_with(b"SYNTHETIC-NONLIVE-")
+        || !token[18..].iter().all(u8::is_ascii_hexdigit)
+        || !lower_hex(&candidate.nonce)
+        || !lower_hex(&candidate.fixture_sha256)
+        || !lower_hex(&candidate.context_digest)
+    {
+        // Refusal still consumes the slot. The rejected candidate wipes on drop.
+        let _ = slot.set(Mutex::new(None));
+        return Err(INVALID);
+    }
+    // Publication is atomic with installation. A prior failure or clear wins
+    // permanently, and an unpublished candidate wipes on drop.
+    slot.set(Mutex::new(Some(candidate))).map_err(|_| INVALID)
+}
+
+/// Wipe the selected session after the strict runtime has stopped. Holding the
+/// same mutex as the transport also waits out any in-progress request operation.
+pub fn clear() {
+    clear_slot(&STATE);
+}
+
+fn clear_slot(slot: &OnceLock<Mutex<Option<State>>>) {
+    let mut state = slot
+        .get_or_init(|| Mutex::new(None))
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    drop(state.take());
+}
+
+pub fn set_rpc_ids(thread_id: &str, turn_id: &str) -> Result<(), &'static str> {
+    let state = STATE.get().ok_or("SYMPHONY_PROVIDER_CONTEXT_INVALID")?;
+    let mut state = state
+        .lock()
+        .map_err(|_| "SYMPHONY_PROVIDER_CONTEXT_INVALID")?;
+    let state = state.as_mut().ok_or("SYMPHONY_PROVIDER_CONTEXT_INVALID")?;
+    if thread_id.is_empty()
+        || turn_id.is_empty()
+        || state
+            .thread_id
+            .as_deref()
+            .is_some_and(|value| value != thread_id)
+        || state
+            .turn_id
+            .as_deref()
+            .is_some_and(|value| value != turn_id)
+    {
+        return Err("SYMPHONY_PROVIDER_CONTEXT_INVALID");
+    }
+    state.thread_id = Some(thread_id.to_owned());
+    state.turn_id = Some(turn_id.to_owned());
+    Ok(())
+}
+
+fn lower_hex(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+struct FixedAuth;
+impl AuthProvider for FixedAuth {
+    fn add_auth_headers(&self, headers: &mut HeaderMap) {
+        let Some(state) = STATE.get() else { return };
+        let Ok(state) = state.lock() else { return };
+        let Some(state) = state.as_ref() else { return };
+        let mut value = b"Bearer ".to_vec();
+        value.extend_from_slice(&state.token.0);
+        if let Ok(header) = HeaderValue::from_bytes(&value) {
+            headers.insert(header::AUTHORIZATION, header);
+        }
+        value.fill(0);
+    }
+}
+
+pub(crate) fn client() -> Result<(Provider, SharedAuthProvider), &'static str> {
+    if STATE.get().is_none() {
+        return Err("SYMPHONY_PROVIDER_CONTEXT_INVALID");
+    }
+    Ok((
+        Provider {
+            name: "symphony-synthetic".into(),
+            base_url: "https://api.openai.com/v1".into(),
+            query_params: None,
+            headers: HeaderMap::new(),
+            retry: RetryConfig {
+                max_attempts: 1,
+                base_delay: std::time::Duration::ZERO,
+                retry_429: false,
+                retry_5xx: false,
+                retry_transport: false,
+            },
+            stream_idle_timeout: std::time::Duration::from_secs(5),
+        },
+        Arc::new(FixedAuth),
+    ))
+}
+
+fn io_error() -> TransportError {
+    TransportError::Build("SYMPHONY_PROVIDER_PIPE_REFUSED".into())
+}
+
+fn monotonic_ms() -> Result<u64, TransportError> {
+    let mut time = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut time) } != 0 {
+        return Err(io_error());
+    }
+    Ok(time.tv_sec as u64 * 1000 + time.tv_nsec as u64 / 1_000_000)
+}
+
+fn wait_fd(fd: i32, events: i16, deadline_ms: u64) -> Result<(), TransportError> {
+    let remaining = deadline_ms.saturating_sub(monotonic_ms()?);
+    if remaining == 0 {
+        return Err(io_error());
+    }
+    let mut descriptor = libc::pollfd {
+        fd,
+        events,
+        revents: 0,
+    };
+    let observed = unsafe { libc::poll(&mut descriptor, 1, remaining.min(i32::MAX as u64) as i32) };
+    if observed <= 0 || descriptor.revents & (events | libc::POLLHUP) == 0 {
+        return Err(io_error());
+    }
+    Ok(())
+}
+
+fn write_bytes(
+    file: &mut std::fs::File,
+    bytes: &[u8],
+    deadline_ms: u64,
+) -> Result<(), TransportError> {
+    use std::os::fd::AsRawFd;
+    let mut offset = 0;
+    while offset < bytes.len() {
+        wait_fd(file.as_raw_fd(), libc::POLLOUT, deadline_ms)?;
+        let wrote = unsafe {
+            libc::write(
+                file.as_raw_fd(),
+                bytes[offset..].as_ptr().cast(),
+                bytes.len() - offset,
+            )
+        };
+        if wrote <= 0 {
+            return Err(io_error());
+        }
+        offset += wrote as usize;
+    }
+    Ok(())
+}
+
+fn read_bytes(
+    file: &mut std::fs::File,
+    bytes: &mut [u8],
+    deadline_ms: u64,
+) -> Result<(), TransportError> {
+    use std::os::fd::AsRawFd;
+    let mut offset = 0;
+    while offset < bytes.len() {
+        wait_fd(file.as_raw_fd(), libc::POLLIN, deadline_ms)?;
+        let read = unsafe {
+            libc::read(
+                file.as_raw_fd(),
+                bytes[offset..].as_mut_ptr().cast(),
+                bytes.len() - offset,
+            )
+        };
+        if read <= 0 {
+            return Err(io_error());
+        }
+        offset += read as usize;
+    }
+    Ok(())
+}
+
+fn write_frame(
+    file: &mut std::fs::File,
+    value: &Value,
+    deadline_ms: u64,
+) -> Result<(), TransportError> {
+    let bytes = serde_json::to_vec(value).map_err(|_| io_error())?;
+    if bytes.is_empty() || bytes.len() > FRAME_LIMIT {
+        return Err(io_error());
+    }
+    write_bytes(file, &(bytes.len() as u32).to_be_bytes(), deadline_ms)?;
+    write_bytes(file, &bytes, deadline_ms)
+}
+
+fn read_frame(file: &mut std::fs::File, deadline_ms: u64) -> Result<Value, TransportError> {
+    let mut size = [0_u8; 4];
+    read_bytes(file, &mut size, deadline_ms)?;
+    let size = u32::from_be_bytes(size) as usize;
+    if size == 0 || size > FRAME_LIMIT {
+        return Err(io_error());
+    }
+    let mut bytes = vec![0; size];
+    read_bytes(file, &mut bytes, deadline_ms)?;
+    serde_json::from_slice(&bytes).map_err(|_| io_error())
+}
+
+fn binding(state: &mut State, kind: &str, ordinal: u64) -> Value {
+    state.sequence += 1;
+    json!({
+        "schema":"H100-EFFECT-PIPE-1", "kind":kind,
+        "context_digest":state.context_digest, "thread_id":state.thread_id,
+        "turn_id":state.turn_id, "nonce":state.nonce, "ordinal":ordinal,
+        "sequence":state.sequence, "deadline_ms":state.deadline_ms
+    })
+}
+
+fn check_common(
+    state: &State,
+    frame: &Value,
+    kind: &str,
+    ordinal: u64,
+) -> Result<(), TransportError> {
+    if frame.get("schema").and_then(Value::as_str) != Some("H100-EFFECT-PIPE-1")
+        || frame.get("kind").and_then(Value::as_str) != Some(kind)
+        || frame.get("context_digest").and_then(Value::as_str)
+            != Some(state.context_digest.as_str())
+        || frame.get("thread_id").and_then(Value::as_str) != state.thread_id.as_deref()
+        || frame.get("turn_id").and_then(Value::as_str) != state.turn_id.as_deref()
+        || frame.get("nonce").and_then(Value::as_str) != Some(state.nonce.as_str())
+        || frame.get("ordinal").and_then(Value::as_u64) != Some(ordinal)
+        || frame.get("deadline_ms").and_then(Value::as_u64) != Some(state.deadline_ms)
+    {
+        return Err(io_error());
+    }
+    Ok(())
+}
+
+fn exact_keys(value: &Value, expected: &[&str]) -> Result<(), TransportError> {
+    let object = value.as_object().ok_or_else(io_error)?;
+    if object.len() != expected.len() || object.keys().any(|key| !expected.contains(&key.as_str()))
+    {
+        return Err(io_error());
+    }
+    Ok(())
+}
+
+fn check_ack(
+    state: &State,
+    frame: &Value,
+    kind: &str,
+    ordinal: u64,
+    sequence: u64,
+) -> Result<(), TransportError> {
+    check_common(state, frame, kind, ordinal)?;
+    let expected: &[&str] = match kind {
+        "PRE_SEND_INTENT" => &[
+            "schema",
+            "kind",
+            "context_digest",
+            "thread_id",
+            "turn_id",
+            "nonce",
+            "ordinal",
+            "sequence",
+            "deadline_ms",
+            "request_id",
+            "descriptor_sha256",
+            "revision",
+        ],
+        "INVOCATION_PERMITTED" => &[
+            "schema",
+            "kind",
+            "context_digest",
+            "thread_id",
+            "turn_id",
+            "nonce",
+            "ordinal",
+            "sequence",
+            "deadline_ms",
+            "request_id",
+            "revision",
+            "ack_nonce",
+        ],
+        "DURABLE_OBSERVATION" => &[
+            "schema",
+            "kind",
+            "context_digest",
+            "thread_id",
+            "turn_id",
+            "nonce",
+            "ordinal",
+            "sequence",
+            "deadline_ms",
+            "stage",
+            "request_id",
+            "response_id",
+        ],
+        _ => return Err(io_error()),
+    };
+    exact_keys(frame, expected)?;
+    if frame.get("sequence").and_then(Value::as_u64) != Some(sequence) {
+        return Err(io_error());
+    }
+    Ok(())
+}
+
+fn check_fixture_sequence(
+    state: &mut State,
+    frame: &Value,
+    kind: &str,
+    ordinal: u64,
+) -> Result<(), TransportError> {
+    check_common(state, frame, kind, ordinal)?;
+    let expected: &[&str] = match kind {
+        "ACCEPTANCE" => &[
+            "schema",
+            "kind",
+            "context_digest",
+            "thread_id",
+            "turn_id",
+            "nonce",
+            "ordinal",
+            "sequence",
+            "deadline_ms",
+            "response_id",
+        ],
+        "SSE_CHUNK" => &[
+            "schema",
+            "kind",
+            "context_digest",
+            "thread_id",
+            "turn_id",
+            "nonce",
+            "ordinal",
+            "sequence",
+            "deadline_ms",
+            "data",
+        ],
+        "TERMINAL" => &[
+            "schema",
+            "kind",
+            "context_digest",
+            "thread_id",
+            "turn_id",
+            "nonce",
+            "ordinal",
+            "sequence",
+            "deadline_ms",
+            "response_id",
+            "response_completed",
+        ],
+        _ => return Err(io_error()),
+    };
+    exact_keys(frame, expected)?;
+    let sequence = frame
+        .get("sequence")
+        .and_then(Value::as_u64)
+        .ok_or_else(io_error)?;
+    if sequence != state.fixture_sequence + 1 {
+        return Err(io_error());
+    }
+    state.fixture_sequence = sequence;
+    Ok(())
+}
+
+fn validate_request(req: &Request, state: &mut State) -> Result<(Vec<u8>, String), TransportError> {
+    if req.method != Method::POST
+        || req.url != URL
+        || req.compression != codex_client::RequestCompression::None
+    {
+        return Err(io_error());
+    }
+    let allowed = [header::AUTHORIZATION, header::ACCEPT, header::CONTENT_TYPE];
+    if req.headers.keys().any(|name| !allowed.contains(name))
+        || req.headers.len() != 3
+        || req.headers.get(header::ACCEPT).map(HeaderValue::as_bytes)
+            != Some(b"text/event-stream".as_slice())
+        || req
+            .headers
+            .get(header::CONTENT_TYPE)
+            .map(HeaderValue::as_bytes)
+            != Some(b"application/json".as_slice())
+    {
+        return Err(io_error());
+    }
+    let mut expected_auth = b"Bearer ".to_vec();
+    expected_auth.extend_from_slice(&state.token.0);
+    let auth_matches = req
+        .headers
+        .get(header::AUTHORIZATION)
+        .map(HeaderValue::as_bytes)
+        == Some(expected_auth.as_slice());
+    expected_auth.fill(0);
+    if !auth_matches {
+        return Err(io_error());
+    }
+    let body = req.body.as_ref().ok_or_else(io_error)?;
+    let bytes = match body {
+        codex_client::RequestBody::EncodedJson(body) => body.as_bytes().to_vec(),
+        codex_client::RequestBody::Raw(bytes) => bytes.to_vec(),
+        codex_client::RequestBody::Json(value) => {
+            serde_json::to_vec(value).map_err(|_| io_error())?
+        }
+    };
+    let value: Value = serde_json::from_slice(&bytes).map_err(|_| io_error())?;
+    exact_keys(
+        &value,
+        &[
+            "model",
+            "input",
+            "tools",
+            "tool_choice",
+            "parallel_tool_calls",
+            "reasoning",
+            "store",
+            "stream",
+            "include",
+        ],
+    )?;
+    if value.get("model").and_then(Value::as_str) != Some(MODEL)
+        || value.get("store").and_then(Value::as_bool) != Some(false)
+        || value.get("stream").and_then(Value::as_bool) != Some(true)
+        || value.get("parallel_tool_calls").and_then(Value::as_bool) != Some(false)
+        || value.get("tool_choice").and_then(Value::as_str) != Some("auto")
+        || value
+            .get("include")
+            .and_then(Value::as_array)
+            .is_none_or(|items| !items.is_empty())
+    {
+        return Err(io_error());
+    }
+    let tools = value
+        .get("tools")
+        .and_then(Value::as_array)
+        .ok_or_else(io_error)?;
+    use codex_tools::{JsonSchema, ResponsesApiTool, ToolSpec};
+
+    // Match the strict Planner constructor in session/turn.rs using the bound workspace.
+    let properties = std::collections::BTreeMap::from([
+        (
+            "cmd".into(),
+            JsonSchema::string_enum(vec![json!(crate::symphony_boundary::BROKER_COMMAND)], None),
+        ),
+        (
+            "workdir".into(),
+            JsonSchema::string_enum(vec![json!(state.workspace)], None),
+        ),
+        ("login".into(), JsonSchema::boolean(None)),
+        ("tty".into(), JsonSchema::boolean(None)),
+    ]);
+    let required = properties.keys().cloned().collect();
+    let approved_tool = ToolSpec::Function(ResponsesApiTool {
+        name: "exec_command".into(),
+        description: "Read the one approved Planner input.".into(),
+        strict: true,
+        defer_loading: None,
+        parameters: JsonSchema::object(properties, Some(required), Some(false.into())),
+        output_schema: None,
+    });
+    let approved_tools = codex_tools::create_tools_json_for_responses_api(&[approved_tool])
+        .map_err(|_| io_error())?;
+    if tools != &approved_tools {
+        return Err(io_error());
+    }
+    let input = value
+        .get("input")
+        .and_then(Value::as_array)
+        .ok_or_else(io_error)?;
+    if input.is_empty()
+        || input.iter().any(|item| {
+            item.get("type")
+                .and_then(Value::as_str)
+                .is_some_and(|kind| {
+                    !matches!(kind, "message" | "function_call_output" | "function_call")
+                })
+        })
+    {
+        return Err(io_error());
+    }
+    state.ordinal += 1;
+    if state.ordinal > 2 || (state.ordinal == 2 && !state.prior_terminal) {
+        return Err(io_error());
+    }
+    let outputs = value
+        .get("input")
+        .and_then(Value::as_array)
+        .ok_or_else(io_error)?
+        .iter()
+        .filter(|item| item.get("type").and_then(Value::as_str) == Some("function_call_output"))
+        .collect::<Vec<_>>();
+    let tool_output = if state.ordinal == 1 {
+        if !outputs.is_empty() {
+            return Err(io_error());
+        }
+        None
+    } else {
+        if outputs.len() != 1 {
+            return Err(io_error());
+        }
+        let output = outputs[0];
+        let call_id = output
+            .get("call_id")
+            .and_then(Value::as_str)
+            .ok_or_else(io_error)?;
+        if state.tool_call_id.as_deref() != Some(call_id) {
+            return Err(io_error());
+        }
+        let output = output
+            .get("output")
+            .and_then(Value::as_str)
+            .ok_or_else(io_error)?;
+        let bytes = output.as_bytes();
+        Some(((state.digest)(bytes), bytes.len()))
+    };
+    let body_sha256 = (state.digest)(&bytes);
+    let descriptor = json!({
+        "request_id":null,
+        "method":"POST", "url":URL, "model":MODEL,
+        "body_sha256":body_sha256, "body_length":bytes.len(),
+        "content_type":"application/json", "stream":true, "store":false,
+        "parallel_tool_calls":false,
+        "tool_schema_sha256":(state.digest)(&serde_json::to_vec(value.get("tools").unwrap_or(&Value::Null)).map_err(|_| io_error())?),
+        "prior_response_id":state.response_id,
+        "tool_call_id":state.tool_call_id,
+        "tool_output_sha256":tool_output.as_ref().map(|value| value.0.clone()),
+        "tool_output_length":tool_output.map(|value| value.1)
+    });
+    Ok((
+        bytes,
+        (state.digest)(&serde_json::to_vec(&descriptor).map_err(|_| io_error())?),
+    ))
+}
+
+fn observe_sse(bytes: &[u8], ordinal: u64, state: &mut State) -> Result<String, TransportError> {
+    let text = std::str::from_utf8(bytes).map_err(|_| io_error())?;
+    let mut events = text.split("\n\n").filter(|block| !block.is_empty());
+    let mut next_event = |expected: &str| -> Result<Value, TransportError> {
+        let mut lines = events.next().ok_or_else(io_error)?.lines();
+        if lines.next().and_then(|line| line.strip_prefix("event: ")) != Some(expected) {
+            return Err(io_error());
+        }
+        let data = lines
+            .next()
+            .and_then(|line| line.strip_prefix("data: "))
+            .ok_or_else(io_error)?;
+        let payload: Value = serde_json::from_str(data).map_err(|_| io_error())?;
+        if lines.next().is_some() || payload["type"].as_str() != Some(expected) {
+            return Err(io_error());
+        }
+        Ok(payload)
+    };
+
+    let created = next_event("response.created")?;
+    let done = next_event("response.output_item.done")?;
+    let completed = next_event("response.completed")?;
+    let response = &completed["response"];
+    let id = created["response"]["id"]
+        .as_str()
+        .filter(|id| !id.is_empty())
+        .ok_or_else(io_error)?;
+    let item = &done["item"];
+    let output = response["output"].as_array().ok_or_else(io_error)?;
+    if events.next().is_some()
+        || created["response"]["model"].as_str() != Some(MODEL)
+        || response["model"].as_str() != Some(MODEL)
+        || created["response"]["status"].as_str() != Some("in_progress")
+        || done["response_id"].as_str() != Some(id)
+        || done
+            .get("model")
+            .is_some_and(|model| model.as_str() != Some(MODEL))
+        || done["output_index"].as_u64() != Some(0)
+        || response["id"].as_str() != Some(id)
+        || response["status"].as_str() != Some("completed")
+        || response["end_turn"].as_bool() != Some(ordinal == 2)
+        || item["id"].as_str().is_none_or(str::is_empty)
+        || output.as_slice() != std::slice::from_ref(item)
+    {
+        return Err(io_error());
+    }
+
+    if ordinal == 1 {
+        let call = item;
+        if call["type"].as_str() != Some("function_call")
+            || call["name"].as_str() != Some("exec_command")
+        {
+            return Err(io_error());
+        }
+        let call_args = call
+            .get("arguments")
+            .and_then(Value::as_str)
+            .ok_or_else(io_error)?;
+        let args: Value = serde_json::from_str(call_args).map_err(|_| io_error())?;
+        if args.get("cmd").and_then(Value::as_str) != Some(crate::symphony_boundary::BROKER_COMMAND)
+            || args.get("workdir").and_then(Value::as_str) != Some(state.workspace.as_str())
+        {
+            return Err(io_error());
+        }
+        let call_id = call
+            .get("call_id")
+            .and_then(Value::as_str)
+            .ok_or_else(io_error)?;
+        if call_id.is_empty() {
+            return Err(io_error());
+        }
+        // The core's second request must carry this exact real function-call ID.
+        state.tool_call_id = Some(call_id.to_owned());
+    } else if ordinal != 2
+        || item["type"].as_str() != Some("message")
+        || item["phase"].as_str() != Some("final_answer")
+        || item["role"].as_str() != Some("assistant")
+        || item["content"].as_array().is_none_or(|content| {
+            content.is_empty()
+                || content.iter().any(|part| {
+                    part["type"].as_str() != Some("output_text") || part["text"].as_str().is_none()
+                })
+        })
+    {
+        return Err(io_error());
+    }
+    Ok(id.to_owned())
+}
+
+fn response_created_id(bytes: &[u8]) -> Result<Option<String>, TransportError> {
+    let text = std::str::from_utf8(bytes).map_err(|_| io_error())?;
+    for block in text.split("\n\n") {
+        let mut event_name = None;
+        let mut data = String::new();
+        for line in block.lines() {
+            if let Some(value) = line.strip_prefix("event:") {
+                event_name = Some(value.trim());
+            } else if let Some(value) = line.strip_prefix("data:") {
+                if !data.is_empty() {
+                    data.push('\n');
+                }
+                data.push_str(value.trim_start());
+            }
+        }
+        if event_name == Some("response.created") {
+            let payload: Value = serde_json::from_str(&data).map_err(|_| io_error())?;
+            let id = payload
+                .get("response")
+                .and_then(|response| response.get("id"))
+                .and_then(Value::as_str)
+                .filter(|id| !id.is_empty())
+                .ok_or_else(io_error)?;
+            return Ok(Some(id.to_owned()));
+        }
+    }
+    Ok(None)
+}
+
+#[derive(Clone, Debug)]
+pub struct SyntheticTransport;
+
+impl HttpTransport for SyntheticTransport {
+    async fn execute(&self, _req: Request) -> Result<Response, TransportError> {
+        Err(io_error())
+    }
+
+    async fn stream(&self, req: Request) -> Result<StreamResponse, TransportError> {
+        tokio::task::block_in_place(|| self.stream_blocking(req))
+    }
+}
+
+impl SyntheticTransport {
+    fn stream_blocking(&self, req: Request) -> Result<StreamResponse, TransportError> {
+        let state = STATE.get().ok_or_else(io_error)?;
+        let mut state = state.lock().map_err(|_| io_error())?;
+        let mut state = state.as_mut().ok_or_else(io_error)?;
+        if !lower_hex(&state.fixture_sha256) {
+            return Err(io_error());
+        }
+        let (request_body, descriptor_sha256) = validate_request(&req, &mut state)?;
+        let ordinal = state.ordinal;
+        if state.thread_id.is_none() || state.turn_id.is_none() {
+            return Err(io_error());
+        }
+        use std::os::fd::FromRawFd;
+        let fd7_num = unsafe { libc::dup(7) };
+        let fd8_num = unsafe { libc::dup(8) };
+        if fd7_num < 0 || fd8_num < 0 {
+            return Err(io_error());
+        }
+        // SAFETY: dup returns newly owned descriptors, closed by these File values.
+        let mut fd7 = unsafe { std::fs::File::from_raw_fd(fd7_num) };
+        let mut fd8 = unsafe { std::fs::File::from_raw_fd(fd8_num) };
+        let body_value: Value = serde_json::from_slice(&request_body).map_err(|_| io_error())?;
+        let schema = body_value.get("tools").cloned().unwrap_or(Value::Null);
+        let mut message = binding(&mut state, "VALIDATE_DESCRIPTOR", ordinal);
+        message["request_id"] = Value::Null;
+        message["method"] = json!("POST");
+        message["url"] = json!(URL);
+        message["model"] = json!(MODEL);
+        message["body_sha256"] = json!((state.digest)(&request_body));
+        message["body_length"] = json!(request_body.len());
+        message["content_type"] = json!("application/json");
+        message["stream"] = json!(true);
+        message["store"] = json!(false);
+        message["parallel_tool_calls"] = json!(false);
+        message["tool_schema_sha256"] = json!((state.digest)(
+            &serde_json::to_vec(&schema).map_err(|_| io_error())?
+        ));
+        message["prior_response_id"] = json!(state.response_id);
+        message["tool_call_id"] = json!(state.tool_call_id);
+        let input_outputs = body_value
+            .get("input")
+            .and_then(Value::as_array)
+            .ok_or_else(io_error)?;
+        if ordinal == 1 {
+            message["tool_output_sha256"] = Value::Null;
+            message["tool_output_length"] = Value::Null;
+        } else {
+            let tool_output = input_outputs
+                .iter()
+                .find(|item| {
+                    item.get("type").and_then(Value::as_str) == Some("function_call_output")
+                })
+                .ok_or_else(io_error)?;
+            let output = tool_output
+                .get("output")
+                .and_then(Value::as_str)
+                .ok_or_else(io_error)?;
+            message["tool_output_sha256"] = json!((state.digest)(output.as_bytes()));
+            message["tool_output_length"] = json!(output.len());
+        }
+        message["descriptor_sha256"] = json!(descriptor_sha256);
+        exact_keys(
+            &message,
+            &[
+                "schema",
+                "kind",
+                "context_digest",
+                "thread_id",
+                "turn_id",
+                "nonce",
+                "ordinal",
+                "sequence",
+                "deadline_ms",
+                "request_id",
+                "method",
+                "url",
+                "model",
+                "body_sha256",
+                "body_length",
+                "content_type",
+                "stream",
+                "store",
+                "parallel_tool_calls",
+                "tool_schema_sha256",
+                "prior_response_id",
+                "tool_call_id",
+                "tool_output_sha256",
+                "tool_output_length",
+                "descriptor_sha256",
+            ],
+        )?;
+        let descriptor_sequence = message["sequence"].as_u64().ok_or_else(io_error)?;
+        write_frame(&mut fd7, &message, state.deadline_ms)?;
+        let intent = read_frame(&mut fd8, state.deadline_ms)?;
+        check_ack(
+            &state,
+            &intent,
+            "PRE_SEND_INTENT",
+            ordinal,
+            descriptor_sequence,
+        )?;
+        if intent.get("kind").and_then(Value::as_str) != Some("PRE_SEND_INTENT")
+            || intent.get("descriptor_sha256").and_then(Value::as_str) != Some(&descriptor_sha256)
+            || intent.get("revision").and_then(Value::as_u64) != Some(1)
+        {
+            return Err(io_error());
+        }
+        let request_id = intent
+            .get("request_id")
+            .and_then(Value::as_str)
+            .ok_or_else(io_error)?
+            .to_owned();
+        let revision = intent
+            .get("revision")
+            .and_then(Value::as_u64)
+            .ok_or_else(io_error)?;
+        let mut ack = binding(&mut state, "POSSIBLE_SEND_ACK", ordinal);
+        ack["request_id"] = json!(request_id);
+        ack["revision"] = json!(revision);
+        ack["descriptor_sha256"] = json!(descriptor_sha256);
+        exact_keys(
+            &ack,
+            &[
+                "schema",
+                "kind",
+                "context_digest",
+                "thread_id",
+                "turn_id",
+                "nonce",
+                "ordinal",
+                "sequence",
+                "deadline_ms",
+                "request_id",
+                "revision",
+                "descriptor_sha256",
+            ],
+        )?;
+        let ack_sequence = ack["sequence"].as_u64().ok_or_else(io_error)?;
+        write_frame(&mut fd7, &ack, state.deadline_ms)?;
+        let permit = read_frame(&mut fd8, state.deadline_ms)?;
+        check_ack(
+            &state,
+            &permit,
+            "INVOCATION_PERMITTED",
+            ordinal,
+            ack_sequence,
+        )?;
+        if permit.get("kind").and_then(Value::as_str) != Some("INVOCATION_PERMITTED")
+            || permit.get("request_id").and_then(Value::as_str) != Some(&request_id)
+            || permit.get("revision").and_then(Value::as_u64) != Some(2)
+            || permit
+                .get("ack_nonce")
+                .and_then(Value::as_str)
+                .is_none_or(|nonce| !lower_hex(nonce))
+        {
+            return Err(io_error());
+        }
+        state.prior_terminal = false;
+        let mut response = Vec::new();
+        let mut response_id = None;
+        let mut acceptance_reported = false;
+        let mut total = 0;
+        loop {
+            let frame = read_frame(&mut fd8, state.deadline_ms)?;
+            match frame.get("kind").and_then(Value::as_str) {
+                Some("ACCEPTANCE") => {
+                    if response_id.is_some() || !response.is_empty() {
+                        return Err(io_error());
+                    }
+                    check_fixture_sequence(&mut state, &frame, "ACCEPTANCE", ordinal)?;
+                    response_id = frame
+                        .get("response_id")
+                        .and_then(Value::as_str)
+                        .map(str::to_owned);
+                    if response_id.as_deref().is_none_or(str::is_empty) {
+                        return Err(io_error());
+                    }
+                }
+                Some("SSE_CHUNK") => {
+                    check_fixture_sequence(&mut state, &frame, "SSE_CHUNK", ordinal)?;
+                    let text = frame
+                        .get("data")
+                        .and_then(Value::as_str)
+                        .ok_or_else(io_error)?;
+                    if text.len() > CHUNK_TEXT_LIMIT {
+                        return Err(io_error());
+                    }
+                    let chunk = base64::engine::general_purpose::STANDARD
+                        .decode(text)
+                        .map_err(|_| io_error())?;
+                    if chunk.is_empty()
+                        || chunk.len() > 6 * 1024
+                        || total + chunk.len() > RESPONSE_LIMIT
+                    {
+                        return Err(io_error());
+                    }
+                    total += chunk.len();
+                    response.extend_from_slice(&chunk);
+                    if !acceptance_reported && let Some(actual_id) = response_created_id(&response)?
+                    {
+                        if response_id.as_deref() != Some(actual_id.as_str()) {
+                            return Err(io_error());
+                        }
+                        state.response_id = Some(actual_id.clone());
+                        let mut observed = binding(&mut state, "OBSERVED_ACCEPTANCE", ordinal);
+                        observed["request_id"] = json!(request_id);
+                        observed["response_id"] = json!(actual_id);
+                        exact_keys(
+                            &observed,
+                            &[
+                                "schema",
+                                "kind",
+                                "context_digest",
+                                "thread_id",
+                                "turn_id",
+                                "nonce",
+                                "ordinal",
+                                "sequence",
+                                "deadline_ms",
+                                "request_id",
+                                "response_id",
+                            ],
+                        )?;
+                        let observed_sequence =
+                            observed["sequence"].as_u64().ok_or_else(io_error)?;
+                        write_frame(&mut fd7, &observed, state.deadline_ms)?;
+                        let accepted = read_frame(&mut fd8, state.deadline_ms)?;
+                        check_ack(
+                            &state,
+                            &accepted,
+                            "DURABLE_OBSERVATION",
+                            ordinal,
+                            observed_sequence,
+                        )?;
+                        if accepted.get("stage").and_then(Value::as_str) != Some("accepted")
+                            || accepted.get("request_id").and_then(Value::as_str)
+                                != Some(&request_id)
+                            || accepted.get("response_id").and_then(Value::as_str)
+                                != Some(actual_id.as_str())
+                        {
+                            return Err(io_error());
+                        }
+                        acceptance_reported = true;
+                    }
+                }
+                Some("TERMINAL") => {
+                    check_fixture_sequence(&mut state, &frame, "TERMINAL", ordinal)?;
+                    if frame.get("response_completed").and_then(Value::as_bool) != Some(true)
+                        || frame.get("response_id").and_then(Value::as_str)
+                            != response_id.as_deref()
+                        || response.is_empty()
+                        || !acceptance_reported
+                    {
+                        return Err(io_error());
+                    }
+                    break;
+                }
+                _ => return Err(io_error()),
+            }
+        }
+        let observed_response = observe_sse(&response, ordinal, &mut state)?;
+        if observed_response != response_id.as_deref().ok_or_else(io_error)? {
+            return Err(io_error());
+        }
+        state.response_id = response_id.clone();
+        if state.response_id.as_deref() != response_id.as_deref() {
+            return Err(io_error());
+        }
+        let mut observed = binding(&mut state, "TERMINAL_CONFIRMATION", ordinal);
+        observed["request_id"] = json!(request_id);
+        observed["response_id"] = json!(response_id);
+        observed["terminal_sha256"] = json!((state.digest)(&response));
+        observed["terminal_length"] = json!(response.len());
+        exact_keys(
+            &observed,
+            &[
+                "schema",
+                "kind",
+                "context_digest",
+                "thread_id",
+                "turn_id",
+                "nonce",
+                "ordinal",
+                "sequence",
+                "deadline_ms",
+                "request_id",
+                "response_id",
+                "terminal_sha256",
+                "terminal_length",
+            ],
+        )?;
+        let terminal_sequence = observed["sequence"].as_u64().ok_or_else(io_error)?;
+        write_frame(&mut fd7, &observed, state.deadline_ms)?;
+        let durable = read_frame(&mut fd8, state.deadline_ms)?;
+        check_ack(
+            &state,
+            &durable,
+            "DURABLE_OBSERVATION",
+            ordinal,
+            terminal_sequence,
+        )?;
+        if durable.get("kind").and_then(Value::as_str) != Some("DURABLE_OBSERVATION")
+            || durable.get("stage").and_then(Value::as_str) != Some("terminal")
+            || durable.get("request_id").and_then(Value::as_str) != Some(&request_id)
+            || durable.get("response_id").and_then(Value::as_str) != response_id.as_deref()
+        {
+            return Err(io_error());
+        }
+        state.prior_terminal = true;
+        let mut headers = HeaderMap::new();
+        headers.insert(
+            header::CONTENT_TYPE,
+            HeaderValue::from_static("text/event-stream"),
+        );
+        headers.insert("x-request-id", HeaderValue::from_static("synthetic-pipe"));
+        let response_request =
+            Request::new(Method::GET, "https://invalid.local/".into()).with_raw_body(response);
+        let response_bytes = response_request
+            .prepare_body_for_send()
+            .map_err(|_| io_error())?
+            .body
+            .ok_or_else(io_error)?;
+        let bytes = stream::iter(vec![Ok(response_bytes)]);
+        let bytes: ByteStream = Box::pin(bytes);
+        Ok(StreamResponse {
+            status: StatusCode::OK,
+            headers,
+            bytes,
+        })
+    }
+}
