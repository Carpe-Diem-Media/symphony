diff --git a/codex-rs/app-server/src/symphony_gate2.rs b/codex-rs/app-server/src/symphony_gate2.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1c3bdcf2c94bdcea724c0e8a053c16c1ba7057f8
--- /dev/null
+++ b/codex-rs/app-server/src/symphony_gate2.rs
@@ -0,0 +1,648 @@
+//! Early, synthetic-only H-100 holder entry. Never invokes generic startup.
+//!
+//! This is a partial J3/J4 implementation in the actual standalone app-server.
+//! Host custody, broker and provider qualification are absent: thread/turn use
+//! always refuses. Neither initialization nor native readiness proves inference.
+
+pub(crate) fn try_run() -> Option<i32> {
+    let args: Vec<_> = std::env::args_os().skip(1).collect();
+    let selected = args
+        .iter()
+        .any(|arg| arg.to_string_lossy().starts_with("--symphony-"));
+    if !selected {
+        return None;
+    }
+    #[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+    let result = linux::run(&args);
+    #[cfg(not(all(target_os = "linux", target_arch = "x86_64")))]
+    let result: Result<(), &'static str> = Err("SYMPHONY_PLATFORM_REFUSED");
+    Some(match result {
+        Ok(()) => 0,
+        Err(code) => {
+            // Never print arguments, material, requests or provider metadata.
+            eprintln!("{code}");
+            78
+        }
+    })
+}
+
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+mod linux {
+    use codex_app_server_protocol::InitializeParams;
+    use codex_app_server_protocol::InitializeResponse;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+    use serde::Deserialize;
+    use serde_json::json;
+    use sha2::Digest;
+    use std::fs::File;
+    use std::io::Read;
+    use std::io::Write;
+    use std::os::fd::FromRawFd;
+    use std::os::unix::fs::MetadataExt;
+
+    type Result<T> = std::result::Result<T, &'static str>;
+    const REFUSED: &str = "SYMPHONY_HOST_UNQUALIFIED";
+    const THREAD_FLAGS: u32 = (libc::CLONE_VM
+        | libc::CLONE_FS
+        | libc::CLONE_FILES
+        | libc::CLONE_SIGHAND
+        | libc::CLONE_THREAD
+        | libc::CLONE_SYSVSEM
+        | libc::CLONE_SETTLS
+        | libc::CLONE_PARENT_SETTID
+        | libc::CLONE_CHILD_CLEARTID) as u32;
+
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Manifest {
+        schema: u32,
+        profile: String,
+        binding: String,
+        attempt: String,
+        holder_sha256: String,
+        deadline_ms: u64,
+        fault: String,
+        #[serde(default)]
+        context: Option<serde_json::Value>,
+        #[serde(default)]
+        provider: Option<ProviderFixture>,
+    }
+
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct ProviderFixture {
+        nonce: String,
+        fixture_sha256: String,
+    }
+
+    fn now() -> Result<u64> {
+        let mut ts = libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 0,
+        };
+        if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) } != 0 {
+            return Err("SYMPHONY_CLOCK_REFUSED");
+        }
+        Ok(ts.tv_sec as u64 * 1000 + ts.tv_nsec as u64 / 1_000_000)
+    }
+
+    fn sha256_hex(bytes: &[u8]) -> String {
+        format!("{:x}", sha2::Sha256::digest(bytes))
+    }
+
+    fn instruction(code: u16, jt: u8, jf: u8, k: u32) -> libc::sock_filter {
+        libc::sock_filter { code, jt, jf, k }
+    }
+
+    fn protect() -> Result<()> {
+        // Install before manifest, material, configuration or runtime access.
+        let zero = libc::rlimit {
+            rlim_cur: 0,
+            rlim_max: 0,
+        };
+        if unsafe { libc::setrlimit(libc::RLIMIT_CORE, &zero) } != 0
+            || unsafe { libc::prctl(libc::PR_SET_DUMPABLE, 0) } != 0
+            || unsafe { libc::prctl(libc::PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) } != 0
+        {
+            return Err("SYMPHONY_HARDENING_REFUSED");
+        }
+        // seccomp_data: nr=0, arch=4, args[0]=16, args[1]=24,
+        // args[2]=32. Gate both the native architecture and x32 syscall bit.
+        let mut code = vec![
+            instruction(0x20, 0, 0, 4),
+            instruction(0x15, 1, 0, 0xc000003e),
+            instruction(0x06, 0, 0, 0x80000000),
+            instruction(0x20, 0, 0, 0),
+            instruction(0x35, 0, 1, 0x40000000),
+            instruction(0x06, 0, 0, 0x80000000),
+            // Only the exact qualified pthread flags may create a thread.
+            instruction(0x15, 0, 6, libc::SYS_clone as u32),
+            instruction(0x20, 0, 0, 16),
+            instruction(0x15, 0, 3, THREAD_FLAGS),
+            instruction(0x20, 0, 0, 20), // high word of args[0], not child_stack
+            instruction(0x15, 0, 1, 0),
+            instruction(0x06, 0, 0, 0x7fff0000),
+            instruction(0x06, 0, 0, 0x00050000 | libc::EPERM as u32),
+            instruction(0x20, 0, 0, 0),
+            // glibc falls back from ENOSYS clone3 to the guarded clone path.
+            instruction(0x15, 0, 1, libc::SYS_clone3 as u32),
+            instruction(0x06, 0, 0, 0x00050000 | libc::ENOSYS as u32),
+            // Core limits cannot be raised after installation. Read-only
+            // prlimit queries remain available to the thread/runtime library.
+            instruction(0x15, 0, 6, libc::SYS_prlimit64 as u32),
+            instruction(0x20, 0, 0, 32),
+            instruction(0x15, 0, 3, 0),
+            instruction(0x20, 0, 0, 36),
+            instruction(0x15, 0, 1, 0),
+            instruction(0x06, 0, 0, 0x7fff0000),
+            instruction(0x06, 0, 0, 0x00050000 | libc::EPERM as u32),
+            instruction(0x20, 0, 0, 0),
+            instruction(0x15, 0, 4, libc::SYS_prctl as u32),
+            instruction(0x20, 0, 0, 16),
+            instruction(0x15, 0, 1, libc::PR_SET_DUMPABLE as u32),
+            instruction(0x06, 0, 0, 0x00050000 | libc::EPERM as u32),
+            instruction(0x06, 0, 0, 0x7fff0000),
+            instruction(0x20, 0, 0, 0),
+        ];
+        for syscall in [
+            libc::SYS_fork,
+            libc::SYS_vfork,
+            libc::SYS_execve,
+            libc::SYS_execveat,
+            libc::SYS_ptrace,
+            libc::SYS_process_vm_readv,
+            libc::SYS_process_vm_writev,
+            libc::SYS_pidfd_getfd,
+            libc::SYS_kcmp,
