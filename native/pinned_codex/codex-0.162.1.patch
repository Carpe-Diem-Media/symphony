+//! Synchronous hardening helpers for the protected holder entry.
+//!
+//! OS-specific enforcement remains owned by the app-server entry point. This
+//! module intentionally exposes no operation that can relax that enforcement.
+
+pub(crate) fn selected() -> bool {
+    super::is_selected()
+}
diff --git a/codex-rs/core/src/symphony_boundary/mod.rs b/codex-rs/core/src/symphony_boundary/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e8b161e8be310ba7fb77c48483eb5139fb1abf2e
--- /dev/null
+++ b/codex-rs/core/src/symphony_boundary/mod.rs
@@ -0,0 +1,428 @@
+//! Immutable, process-local boundary for the protected synthetic session.
+//!
+//! This module contains no provider transport. Installing a context selects the
+//! strict path for the lifetime of the process; it cannot be cleared or replaced.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Instant;
+
+#[cfg(test)]
+tokio::task_local! {
+    static TEST_SELECTED: std::cell::Cell<EffectCounts>;
+    static TEST_STOP_UNCONFIRMED: std::cell::Cell<bool>;
+}
+
+mod hardening;
+pub mod transport;
+
+/// Validated, non-secret identity and limits supplied by the protected launcher.
+#[derive(Debug, Clone)]
+pub struct SymphonyContext {
+    pub project_id: String,
+    pub work_item_id: String,
+    pub role: String,
+    pub binding_id: String,
+    pub attempt_id: String,
+    pub grant_id: String,
+    pub configuration_digest: String,
+    pub source_commit: String,
+    pub source_tree: String,
+    pub policy_digest: String,
+    pub policy_root: PathBuf,
+    pub policy_text: String,
+    pub holder_sha256: String,
+    pub holder_profile: String,
+    pub holder_profile_digest: String,
+    pub permission_reference: String,
+    pub host_identity: String,
+    pub boot_identity: String,
+    pub credential_generation: String,
+    pub model_slug: String,
+    pub model_catalog_digest: String,
+    pub model_catalog: serde_json::Value,
+    pub text_digest: String,
+    pub prompt_text: String,
+    pub context_digest: String,
+    pub workspace: PathBuf,
+    pub home: PathBuf,
+    pub codex_home: PathBuf,
+    pub deadline: Instant,
+    pub wait_for_interrupt: bool,
+    pub provider_nonce: Option<String>,
+    pub fixture_sha256: Option<String>,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum BoundaryError {
+    #[error("SYMPHONY_CONTEXT_INVALID")]
+    Invalid,
+    #[error("SYMPHONY_CONTEXT_ALREADY_INSTALLED")]
+    AlreadyInstalled,
+}
+
+static CONTEXT: OnceLock<Arc<SymphonyContext>> = OnceLock::new();
+static THREAD_STARTED: AtomicBool = AtomicBool::new(false);
+static TURN_STARTED: AtomicBool = AtomicBool::new(false);
+static AUTH_CALLS: AtomicU64 = AtomicU64::new(0);
+static HTTP_CALLS: AtomicU64 = AtomicU64::new(0);
+static WEBSOCKET_CALLS: AtomicU64 = AtomicU64::new(0);
+static RESPONSES_CALLS: AtomicU64 = AtomicU64::new(0);
+static RETRY_CALLS: AtomicU64 = AtomicU64::new(0);
+static FALLBACK_CALLS: AtomicU64 = AtomicU64::new(0);
+static DISCOVERY_CALLS: AtomicU64 = AtomicU64::new(0);
+static PROCESS_CALLS: AtomicU64 = AtomicU64::new(0);
+static PROVIDER_REFUSALS: AtomicU64 = AtomicU64::new(0);
+
+fn digest(value: &str) -> bool {
+    value.len() == 64 && value.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+fn git_oid(value: &str) -> bool {
+    value.len() == 40 && value.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+/// Install exactly one context after protected startup has validated it.
+pub fn install_context(context: SymphonyContext) -> Result<Arc<SymphonyContext>, BoundaryError> {
+    if context.project_id.is_empty()
+        || context.work_item_id.is_empty()
+        || context.role != "Planner"
+        || context.binding_id.is_empty()
+        || context.attempt_id.is_empty()
+        || context.grant_id.is_empty()
+        || context.configuration_digest.is_empty()
+        || context.holder_sha256.is_empty()
+        || context.holder_profile.is_empty()
+        || context.holder_profile_digest.is_empty()
+        || context.permission_reference.is_empty()
+        || context.host_identity.is_empty()
+        || context.boot_identity.is_empty()
+        || context.credential_generation.is_empty()
+        || context.policy_text.is_empty()
+        || context.prompt_text.is_empty()
+        || context.model_slug.is_empty()
+        || context.holder_profile != "H100_FUNCTIONAL_CODEX_SYNTHETIC_V1"
+        || !git_oid(&context.source_commit)
+        || !git_oid(&context.source_tree)
+        || !digest(&context.policy_digest)
+        || !digest(&context.configuration_digest)
+        || !digest(&context.holder_sha256)
+        || !digest(&context.holder_profile_digest)
+        || !digest(&context.model_catalog_digest)
+        || !digest(&context.text_digest)
+        || !digest(&context.context_digest)
+        || context
+            .provider_nonce
+            .as_ref()
+            .is_some_and(|value| !digest_lower_hex(value))
+        || context
+            .fixture_sha256
+            .as_ref()
+            .is_some_and(|value| !digest_lower_hex(value))
+        || context.provider_nonce.is_some() != context.fixture_sha256.is_some()
+        || !context.workspace.is_absolute()
+        || !context.home.is_absolute()
+        || !context.codex_home.is_absolute()
+        || !context.policy_root.is_absolute()
+        || std::fs::canonicalize(&context.workspace).is_err()
+        || std::fs::canonicalize(&context.home).is_err()
+        || std::fs::canonicalize(&context.codex_home).is_err()
+        || std::fs::canonicalize(&context.policy_root).is_err()
+        || context.deadline <= Instant::now()
+    {
+        return Err(BoundaryError::Invalid);
+    }
+    let context = Arc::new(context);
+    CONTEXT
+        .set(Arc::clone(&context))
+        .map_err(|_| BoundaryError::AlreadyInstalled)?;
+    Ok(context)
+}
+
+fn digest_lower_hex(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+/// Return the selected immutable context, if protected startup installed it.
+pub fn context() -> Option<Arc<SymphonyContext>> {
+    CONTEXT.get().cloned()
+}
+
+struct BoundBroker {
+    backend: Arc<dyn codex_exec_server::ExecBackend>,
+    params: codex_exec_server::ExecParams,
+    call_id: String,
+}
+
+static BROKER: OnceLock<BoundBroker> = OnceLock::new();
+
+pub const BROKER_COMMAND: &str = "/usr/bin/head -n 8 -- planner_input.txt";
+
+pub fn broker_argv() -> Vec<String> {
+    vec!["/usr/bin/dash".into(), "-c".into(), BROKER_COMMAND.into()]
+}
+
+/// Install the transport for the already selected holder. The native permit
+/// and the backend's one-use grant remain the owners of execution authority.
+#[cfg(target_os = "linux")]
+pub fn install_broker(
+    context: &SymphonyContext,
+    backend: Arc<codex_exec_server::SymphonyExecBackend>,
+    params: codex_exec_server::ExecParams,
+    call_id: String,
+) -> Result<(), BoundaryError> {
+    let expected_cwd = codex_utils_path_uri::PathUri::from_host_native_path(&context.workspace)
+        .map_err(|_| BoundaryError::Invalid)?;
+    if !CONTEXT
+        .get()
+        .is_some_and(|selected| std::ptr::eq(selected.as_ref(), context))
+        || context.deadline <= Instant::now()
+        || params.argv != broker_argv()
+        || params.cwd != expected_cwd
+        || call_id.is_empty()
+    {
+        return Err(BoundaryError::Invalid);
+    }
+    BROKER
+        .set(BoundBroker {
+            backend,
+            params,
+            call_id,
+        })
+        .map_err(|_| BoundaryError::AlreadyInstalled)
+}
+
+pub(crate) fn broker_scope() -> Option<(&'static str, &'static str)> {
+    let broker = BROKER.get()?;
+    Some((&broker.call_id, CONTEXT.get()?.workspace.to_str()?))
+}
+
+pub(crate) async fn start_broker(
+    argv: &[String],
+    cwd: &codex_utils_path_uri::PathUri,
+    call_id: Option<&str>,
+) -> Result<codex_exec_server::StartedExecProcess, BoundaryError> {
+    let broker = BROKER.get().ok_or(BoundaryError::Invalid)?;
+    if !CONTEXT
+        .get()
+        .is_some_and(|selected| selected.deadline > Instant::now())
+        || argv != broker.params.argv.as_slice()
+        || cwd != &broker.params.cwd
+        || call_id.is_some_and(|id| id != broker.call_id)
+    {
+        return Err(BoundaryError::Invalid);
+    }
+    broker
+        .backend
+        .start(broker.params.clone())
+        .await
+        .map_err(|_| BoundaryError::Invalid)
+}
+
+/// Run a locally supplied diagnostic input through the selected tool router.
+pub async fn dispatch_broker_tool(
+    name: &str,
+    call_id: &str,
+    arguments: String,
+) -> Result<codex_exec_server::StartedExecProcess, BoundaryError> {
+    use crate::tools::router::{ToolCall, ToolRouter};
+    let call = ToolCall {
+        tool_name: codex_tools::ToolName::plain(name),
+        call_id: call_id.into(),
+        payload: crate::tools::context::ToolPayload::Function { arguments },
+        encrypted_function_args: None,
+    };
+    ToolRouter::start_protected_tool(&call)
+        .await
+        .map_err(|_| BoundaryError::Invalid)
+}
+
+/// Return whether this process uses the protected strict path.
+pub fn is_selected() -> bool {
+    CONTEXT.get().is_some() || {
+        #[cfg(test)]
+        {
+            return TEST_SELECTED.try_with(|_| true).unwrap_or(false);
+        }
+        #[cfg(not(test))]
+        false
+    }
+}
+
+/// Select the strict path only on the current test thread for direct boundary probes.
+#[cfg(test)]
+pub(crate) async fn with_test_selection<F: std::future::Future>(future: F) -> F::Output {
+    TEST_SELECTED
+        .scope(
+            std::cell::Cell::new(EffectCounts::default()),
+            TEST_STOP_UNCONFIRMED.scope(std::cell::Cell::new(false), future),
+        )
+        .await
+}
+
+/// Admit the one real core thread for the selected attempt.
+pub(crate) fn admit_thread() -> bool {
+    !is_selected()
+        || THREAD_STARTED
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+}
+
+/// Admit the one real core turn for the selected attempt.
+pub(crate) fn admit_turn() -> bool {
+    !is_selected()
+        || TURN_STARTED
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+}
+
+/// Record a forbidden side-effect entry immediately before the effect boundary.
+fn count_effect(counter: &AtomicU64, field: fn(&mut EffectCounts) -> &mut u64) {
+    #[cfg(test)]
+    if TEST_SELECTED
+        .try_with(|cell| {
+            let mut counts = cell.get();
+            *field(&mut counts) += 1;
+            cell.set(counts);
+        })
+        .is_ok()
+    {
+        return;
+    }
+    #[cfg(not(test))]
+    let _ = field;
+    counter.fetch_add(1, Ordering::Relaxed);
+}
+
+pub(crate) fn record_auth() {
+    count_effect(&AUTH_CALLS, |counts| &mut counts.auth);
+}
+pub(crate) fn record_http() {
+    count_effect(&HTTP_CALLS, |counts| &mut counts.http);
+}
+pub(crate) fn record_websocket() {
+    count_effect(&WEBSOCKET_CALLS, |counts| &mut counts.websocket);
+}
+pub(crate) fn record_responses() {
+    count_effect(&RESPONSES_CALLS, |counts| &mut counts.responses);
+}
+pub(crate) fn record_retry() {
+    count_effect(&RETRY_CALLS, |counts| &mut counts.retry);
+}
+pub(crate) fn record_fallback() {
+    count_effect(&FALLBACK_CALLS, |counts| &mut counts.fallback);
+}
+pub(crate) fn record_discovery() {
+    count_effect(&DISCOVERY_CALLS, |counts| &mut counts.discovery);
+}
+pub(crate) fn record_process() {
+    count_effect(&PROCESS_CALLS, |counts| &mut counts.process);
+}
+
+/// Build the shared strict refusal and count the observed refusal boundary.
+pub(crate) fn provider_boundary_unavailable() -> codex_protocol::error::CodexErr {
+    count_effect(&PROVIDER_REFUSALS, |counts| &mut counts.provider_refusals);
+    codex_protocol::error::CodexErr::InvalidRequest(
+        "SYMPHONY_PROVIDER_BOUNDARY_UNAVAILABLE".to_string(),
+    )
+}
+
+/// Non-secret effect counts captured by synthetic tests.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct EffectCounts {
+    pub provider_refusals: u64,
+    pub auth: u64,
+    pub http: u64,
+    pub websocket: u64,
+    pub responses: u64,
+    pub retry: u64,
+    pub fallback: u64,
+    pub discovery: u64,
+    pub process: u64,
+}
+
+pub fn effect_counts() -> EffectCounts {
+    #[cfg(test)]
+    if let Ok(counts) = TEST_SELECTED.try_with(std::cell::Cell::get) {
+        return counts;
+    }
+    EffectCounts {
+        provider_refusals: PROVIDER_REFUSALS.load(Ordering::Relaxed),
+        auth: AUTH_CALLS.load(Ordering::Relaxed),
+        http: HTTP_CALLS.load(Ordering::Relaxed),
+        websocket: WEBSOCKET_CALLS.load(Ordering::Relaxed),
+        responses: RESPONSES_CALLS.load(Ordering::Relaxed),
+        retry: RETRY_CALLS.load(Ordering::Relaxed),
+        fallback: FALLBACK_CALLS.load(Ordering::Relaxed),
+        discovery: DISCOVERY_CALLS.load(Ordering::Relaxed),
+        process: PROCESS_CALLS.load(Ordering::Relaxed),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn positive_control_observes_provider_refusal_counter() {
+        with_test_selection(async {
+            let error = provider_boundary_unavailable();
+            assert_eq!(error.to_string(), "SYMPHONY_PROVIDER_BOUNDARY_UNAVAILABLE");
+            assert_eq!(effect_counts().provider_refusals, 1);
+        })
+        .await;
+    }
+
+    #[tokio::test]
+    async fn positive_control_observes_each_provider_effect_counter() {
+        with_test_selection(async {
+            record_auth();
+            record_http();
+            record_websocket();
+            record_responses();
+            record_retry();
+            record_fallback();
+            let after = effect_counts();
+            assert_eq!(after.auth, 1);
+            assert_eq!(after.http, 1);
+            assert_eq!(after.websocket, 1);
+            assert_eq!(after.responses, 1);
+            assert_eq!(after.retry, 1);
+            assert_eq!(after.fallback, 1);
+        })
+        .await;
+    }
+}
+
+/// Observe irreversible admission without consuming another entitlement.
+pub(crate) fn is_turn_admitted() -> bool {
+    TURN_STARTED.load(Ordering::Acquire)
+}
+
+// Component uncertainty is sticky for this same installed attempt. The native
+// owner still decides the final stop disposition from independent observations.
+static STOP_UNCONFIRMED: AtomicBool = AtomicBool::new(false);
+pub(crate) fn mark_stop_unconfirmed() {
+    #[cfg(test)]
+    if TEST_STOP_UNCONFIRMED
+        .try_with(|cell| cell.set(true))
+        .is_ok()
+    {
+        return;
+    }
+    STOP_UNCONFIRMED.store(true, Ordering::Release);
+}
+pub fn stop_unconfirmed() -> bool {
+    #[cfg(test)]
+    if let Ok(value) = TEST_STOP_UNCONFIRMED.try_with(std::cell::Cell::get) {
+        return value;
+    }
+    STOP_UNCONFIRMED.load(Ordering::Acquire)
+}
