+fn is_empty_default_rate_limit(snapshot: &codex_protocol::protocol::RateLimitSnapshot) -> bool {
+    snapshot.limit_id.as_deref() == Some("codex")
+        && snapshot.limit_name.is_none()
+        && snapshot.normal_model_slug.is_none()
+        && snapshot.primary.is_none()
+        && snapshot.secondary.is_none()
+        && snapshot.credits.is_none()
+        && snapshot.individual_limit.is_none()
+        && snapshot.spend_control_reached.is_none()
+        && snapshot.plan_type.is_none()
+        && snapshot.rate_limit_reached_type.is_none()
+}
+
+#[derive(Default)]
+struct StrictResponsePreamble {
+    created: bool,
+    rate_limit_seen: bool,
+}
+
+impl StrictResponsePreamble {
+    // False leaves the event to the strict loop's existing allowlist.
+    fn consume(&mut self, event: &ResponseEvent) -> bool {
+        match event {
+            ResponseEvent::Created { .. } => self.created = true,
+            ResponseEvent::RateLimits(snapshot)
+                if !self.created
+                    && !self.rate_limit_seen
+                    && is_empty_default_rate_limit(snapshot) =>
+            {
+                self.rate_limit_seen = true;
+                return true;
+            }
+            _ => {}
+        }
+        false
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn strict_response_preamble_accepts_only_one_exact_default_before_created() {
+    fn default_snapshot() -> codex_protocol::protocol::RateLimitSnapshot {
+        codex_protocol::protocol::RateLimitSnapshot {
+            limit_id: Some("codex".into()),
+            limit_name: None,
+            normal_model_slug: None,
+            primary: None,
+            secondary: None,
+            credits: None,
+            individual_limit: None,
+            spend_control_reached: None,
+            plan_type: None,
+            rate_limit_reached_type: None,
+        }
+    }
+
+    let created = ResponseEvent::Created { response_id: None };
+    let exact = ResponseEvent::RateLimits(default_snapshot());
+    let populated = ResponseEvent::RateLimits(codex_protocol::protocol::RateLimitSnapshot {
+        spend_control_reached: Some(false),
+        ..default_snapshot()
+    });
+    let different = ResponseEvent::RateLimits(codex_protocol::protocol::RateLimitSnapshot {
+        limit_id: Some("different".into()),
+        ..default_snapshot()
+    });
+    // Each selected response starts with an independent, identical preamble.
+    for mut preamble in [
+        StrictResponsePreamble::default(),
+        StrictResponsePreamble::default(),
+    ] {
+        assert!(!preamble.consume(&populated));
+        assert!(!preamble.consume(&different));
+        assert!(!preamble.consume(&ResponseEvent::ModelsEtag("unexpected".into())));
+        assert!(preamble.consume(&exact));
+        assert!(!preamble.consume(&exact));
+        assert!(!preamble.consume(&created));
+    }
+    let mut without_metadata = StrictResponsePreamble::default();
+    assert!(!without_metadata.consume(&created));
+    assert!(without_metadata.created);
+    assert!(!without_metadata.consume(&exact));
+}
