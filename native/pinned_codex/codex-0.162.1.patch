+        let mut diagnostic = StrictR1Diagnostic::default();
+        assert_eq!(diagnostic.checked(branch, Err::<(), _>(7)), Err(7));
+        assert_eq!(diagnostic.checked("later_error", Err::<(), _>(8)), Err(8));
+        assert_eq!(diagnostic.failure, Some(branch));
+        assert_eq!(diagnostic.checked("success", Ok::<_, u8>(9)), Ok(9));
+    }
+}
