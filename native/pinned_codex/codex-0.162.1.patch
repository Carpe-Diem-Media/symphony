+#[cfg(test)]
+mod material_tests {
+    use super::*;
+
+    fn candidate(token: Vec<u8>) -> State {
+        State {
+            token: Secret(token),
+            nonce: "a".repeat(64),
+            fixture_sha256: "b".repeat(64),
+            context_digest: "c".repeat(64),
+            deadline_ms: 1,
+            digest: |_| String::new(),
+            ordinal: 0,
+            sequence: 0,
+            fixture_sequence: 0,
+            thread_id: None,
+            turn_id: None,
+            response_id: None,
+            tool_call_id: None,
+            prior_terminal: false,
+            workspace: String::new(),
+        }
+    }
+
+    fn material() -> Vec<u8> {
+        [b"SYNTHETIC-NONLIVE-".as_slice(), &[b'a'; 32]].concat()
+    }
+
+    fn response_events(ordinal: u64) -> [Value; 3] {
+        let item = if ordinal == 1 {
+            json!({"id":"item-1", "type":"function_call", "name":"exec_command",
+                "call_id":"fixture-call", "arguments":json!({
+                    "cmd":crate::symphony_boundary::BROKER_COMMAND, "workdir":"/fixture", "login":false
+                }).to_string()})
+        } else {
+            json!({"id":"item-2", "type":"message", "role":"assistant", "phase":"final_answer",
+                "content":[{"type":"output_text", "text":"fixture answer", "annotations":[]}]})
+        };
+        [
+            json!({"type":"response.created", "response":{"id":"response-1", "model":"synthetic-planner-v1", "status":"in_progress"}}),
+            json!({"type":"response.output_item.done", "response_id":"response-1", "output_index":0, "item":item}),
+            json!({"type":"response.completed", "response":{"id":"response-1", "model":"synthetic-planner-v1",
+                "status":"completed", "output":[item], "end_turn":ordinal == 2}}),
+        ]
+    }
+
+    fn observe(events: &[Value], ordinal: u64) -> Result<String, TransportError> {
+        let stream = events
+            .iter()
+            .map(|event| {
+                format!(
+                    "event: {}\ndata: {event}\n\n",
+                    event["type"].as_str().unwrap()
+                )
+            })
+            .collect::<String>();
+        let mut state = candidate(material());
+        state.workspace = "/fixture".into();
+        observe_sse(stream.as_bytes(), ordinal, &mut state)
+    }
+
+    #[test]
+    fn matching_synthetic_responses_are_accepted() {
+        for ordinal in [1, 2] {
+            assert_eq!(
+                observe(&response_events(ordinal), ordinal).unwrap(),
+                "response-1"
+            );
+        }
+    }
+
+    #[test]
+    fn response_identity_and_model_must_match_the_selected_turn() {
+        for (index, field) in [
+            (0, "/response/model"),
+            (2, "/response/model"),
+            (1, "/response_id"),
+            (2, "/response/id"),
+        ] {
+            let mut events = response_events(2);
+            *events[index].pointer_mut(field).unwrap() = json!("different");
+            assert!(observe(&events, 2).is_err(), "{index} {field}");
+        }
+        let mut events = response_events(2);
+        events[0]["response"]["model"] = json!("different-model");
+        events[2]["response"]["model"] = json!("different-model");
+        assert!(observe(&events, 2).is_err());
+
+        let mut events = response_events(2);
+        events[1].as_object_mut().unwrap().remove("response_id");
+        assert!(observe(&events, 2).is_err());
+    }
+
+    #[test]
+    fn completed_item_must_match_the_actual_tool_arguments_or_final_content() {
+        let mut tool_events = response_events(1);
+        let terminal = &mut tool_events[2]["response"]["output"][0]["arguments"];
+        let mut arguments: Value = serde_json::from_str(terminal.as_str().unwrap()).unwrap();
+        arguments["login"] = json!(true);
+        *terminal = json!(arguments.to_string());
+        assert!(observe(&tool_events, 1).is_err());
+
+        for (field, value) in [
+            ("/id", json!("wrong-item")),
+            ("/content/0/text", json!("contradictory final answer")),
+            ("/content/0/annotations", json!([{"type":"different"}])),
+        ] {
+            let mut events = response_events(2);
+            *events[2]["response"]["output"][0]
+                .pointer_mut(field)
+                .unwrap() = value;
+            assert!(observe(&events, 2).is_err(), "{field}");
+        }
+    }
+
+    #[test]
+    fn missing_duplicated_or_reordered_evidence_is_rejected() {
+        let [created, done, terminal] = response_events(2);
+        assert!(observe(&[created.clone(), done.clone()], 2).is_err());
+        assert!(observe(&[created.clone(), terminal.clone(), done.clone()], 2).is_err());
+        assert!(
+            observe(
+                &[
+                    created.clone(),
+                    done.clone(),
+                    terminal.clone(),
+                    terminal.clone()
+                ],
+                2
+            )
+            .is_err()
+        );
+        let mut duplicated = terminal.clone();
+        let item = done["item"].clone();
+        duplicated["response"]["output"] = json!([item, item]);
+        assert!(
+            observe(
+                &[created.clone(), done.clone(), done.clone(), duplicated],
+                2
+            )
+            .is_err()
+        );
+        let mut missing = terminal;
+        missing["response"]
+            .as_object_mut()
+            .unwrap()
+            .remove("output");
+        assert!(observe(&[created, done, missing], 2).is_err());
+    }
+
+    #[test]
+    fn material_ownership_is_one_use_and_terminal() {
+        let slot = OnceLock::new();
+        let mut temporary = material();
+        assert!(install_into(&slot, candidate(std::mem::take(&mut temporary))).is_ok());
