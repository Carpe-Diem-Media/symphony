+#[derive(Default)]
+struct StrictR1Diagnostic {
+    stages: Vec<&'static str>,
+    failure: Option<&'static str>,
+    event_counts: [u32; 7],
+    end_turn: Option<Option<bool>>,
+    output_item_count: usize,
+    function_call_present: bool,
+}
+
+impl StrictR1Diagnostic {
+    fn stage(&mut self, stage: &'static str) {
+        self.stages.push(stage);
+    }
+
+    fn checked<T, E>(&mut self, branch: &'static str, result: Result<T, E>) -> Result<T, E> {
+        result.inspect_err(|_| {
+            self.failure.get_or_insert(branch);
+        })
+    }
+}
+
+impl Drop for StrictR1Diagnostic {
+    fn drop(&mut self) {
+        use std::io::Write as _;
+        let counts = self.event_counts;
+        let record = serde_json::json!({
+            "schema": "H100_R1_STAGE_1",
+            "stages": self.stages,
+            "failure": self.failure,
+            "event_counts": {"created": counts[0], "output_item_added": counts[1],
+                "output_item_done": counts[2], "completed": counts[3],
+                "output_text_delta": counts[4], "tool_call_input_delta": counts[5], "other": counts[6]},
+            "completion_seen": self.end_turn.is_some(),
+            "end_turn": self.end_turn.flatten(),
+            "output_item_count": self.output_item_count,
+            "function_call_present": self.function_call_present,
+        });
+        let _ = writeln!(std::io::stderr().lock(), "{record}");
+    }
+}
