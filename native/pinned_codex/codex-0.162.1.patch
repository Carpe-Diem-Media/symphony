+pub fn run(
+    value: Value,
+    deadline: u64,
+    synthetic_token: Vec<u8>,
+    provider: Option<(String, String)>,
+    digest: fn(&[u8]) -> String,
+) -> Result<()> {
+    let broker = value.get("broker_selftest").cloned();
+    let ctx = context(value, deadline, provider.clone())?;
+    if let Some((nonce, fixture_sha256)) = provider {
+        let selection = broker.as_ref().ok_or("SYMPHONY_BROKER_REFUSED")?;
+        install_selected_broker(&ctx, selection, deadline)?;
+        codex_core::symphony_boundary::transport::install(
+            synthetic_token,
+            nonce,
+            fixture_sha256,
+            ctx.context_digest.clone(),
+            deadline,
+            digest,
+            ctx.workspace.to_string_lossy().into_owned(),
+        )
+        .map_err(|_| "SYMPHONY_PROVIDER_CONTEXT_INVALID")?;
+    } else if let Some(broker) = broker {
+        return run_broker(&ctx, broker, deadline);
+    }
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(1)
+        // Match the pinned arg0 runtime stack budget without its helper dispatch.
+        // Core turn futures require this budget even when external services are absent.
+        .thread_stack_size(16 * 1024 * 1024)
+        .enable_time()
+        .build()
+        .map_err(|_| "SYMPHONY_THREAD_REFUSED")?;
+    let result = runtime.block_on(async {
+        if tokio::spawn(async { 1621_u32 })
+            .await
+            .map_err(|_| "SYMPHONY_THREAD_REFUSED")?
+            != 1621
+        {
+            return Err("SYMPHONY_THREAD_REFUSED");
+        }
+        session(ctx, deadline).await
+    });
+    let counts = codex_core::symphony_boundary::effect_counts();
+    // Synthetic-only audit metadata, separate from real core protocol events.
+    // Zero counts do not prove coverage of a client entry that was never reached.
+    eprintln!(
+        "{}",
+        json!({"symphonySyntheticCounts": {
+            "providerRefusals":counts.provider_refusals, "auth":counts.auth,
+            "http":counts.http, "websocket":counts.websocket, "responses":counts.responses,
+            "retry":counts.retry, "fallback":counts.fallback,
+            "discovery":counts.discovery, "process":counts.process
+        }})
+    );
+    result
+}
