+fn strict_turn_request_is_valid(
+    session: &Session,
+    request: &TurnInputRequest,
+    mode: &TurnInputMode,
+    has_turn_extension_init: bool,
+) -> bool {
+    let Some(context) = crate::symphony_boundary::context() else {
+        return false;
+    };
+    if !session
+        .services
+        .strict_context()
+        .is_ok_and(|bound| std::ptr::eq(bound, context.as_ref()))
+        || context.deadline <= std::time::Instant::now()
+        || has_turn_extension_init
+        || *mode != TurnInputMode::StartIfIdle
+        || request.thread_settings != Default::default()
+        || request.start.turn_trigger.is_some()
+        || request.start.final_output_json_schema.is_some()
+        || request.start.service_tier.is_some()
+        || request.start.parent_turn_id.is_some()
+        || request.start.initiating_agent_path.is_some()
+        || request.start.root_turn_id.is_some()
+        || request.start.cyber_access_program.is_some()
+        || !request.additional_context.is_empty()
+        || request.responsesapi_client_metadata.is_some()
+        || request.trace.is_some()
+    {
+        return false;
+    }
+    match &request.input {
+        SubmittedTurnInput::UserInput { content, client_id } if client_id.is_none() => {
+            matches!(content.as_slice(), [UserInput::Text { text, text_elements }] if text == &context.prompt_text && text_elements.is_empty())
+        }
+        _ => false,
+    }
+}
